{
  "name": "planet-crafter-save-tools",
  "version": "1.0.0",
  "description": "A set of tools to manipulate Planet Crafter save files",
  "packageManager": "bun@1.4.2",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/cli-merge",
      "packages/cli-validate",
      "packages/core-mapping",
      "packages/shared-platforms",
      "packages/shared-save-processing",
      "packages/ui-save-manager",
      "packages/util-types"
    ]
  },
  "type": "module",
  "scripts": {
    "postinstall": "sh scripts/sync-private-context.sh",
    "private:sync": "sh scripts/sync-private-context.sh",
    "clean": "rm -rf node_modules",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ui": "bun run --filter ui-save-manager test:ui",
    "test:ui:install": "bun run --filter ui-save-manager test:ui:install",
    "lint:types": "tsc --noEmit && bun run --filter './packages/*' lint:types",
    "build:ui": "bun run --filter ui-save-manager build",
    "audit:quality": "bun run check:guards && bun run fallow:quality && bun run fallow:health",
    "release:verify": "bun run lint:types && bun run audit:quality && bun test && bun run test:ui && bun run audit",
    "check:guards": "bun run check:assertions && bun run check:fixtures && bun run check:dependencies && bun run check:presentation && bun run check:idioms && bun run check:scenario-fixtures && bun run check:locators && bun run check:anchors && bun run check:contrast && bun run validate:tables && bun run check:audit-ignores",
    "check:assertions": "bun scripts/check-test-assertions.ts",
    "check:contrast": "bun scripts/check-color-contrast.ts",
    "check:fixtures": "bun scripts/check-fixture-typing.ts",
    "check:dependencies": "bun scripts/check-package-dependencies.ts",
    "check:presentation": "bun scripts/check-presentation-entities.ts",
    "check:idioms": "bun scripts/check-solid-idioms.ts",
    "check:scenario-fixtures": "bun scripts/check-scenario-fixtures.ts",
    "check:locators": "bun scripts/check-scenario-locators.ts",
    "check:anchors": "bun scripts/check-corpus-anchors.ts",
    "check:audit-ignores": "bun scripts/check-audit-ignores.ts",
    "generate:scenario-fixtures": "bun scripts/generate-scenario-fixtures.ts",
    "fallow:quality": "fallow audit --config ./fallow.toml --base master --no-cache --ci",
    "fallow:quality:local": "fallow audit --config ./fallow.toml --base master --no-cache",
    "fallow:health": "fallow health --config ./fallow.toml --base master --no-cache --ci",
    "fallow:health:local": "fallow health --config ./fallow.toml --base master --no-cache",
    "audit": "bun audit --audit-level=moderate --ignore=GHSA-3v7f-55p6-f55p --ignore=GHSA-c2c7-rcm5-vvqj",
    "dev:ui": "bun run --filter ui-save-manager dev",
    "preview:ui": "bun run --filter ui-save-manager preview",
    "clean:ui": "bun run --filter ui-save-manager clean",
    "merge": "bun run --filter cli-merge merge",
    "clean:merge": "rm -rf output",
    "test:merge": "bun test --filter cli-merge",
    "validate": "bun run --filter cli-validate validate",
    "validate:tables": "bun run --filter './packages/*' validate:tables",
    "test:validate": "bun test --filter cli-validate",
    "node:merge": "node --import ./scripts/node/register.js packages/cli-merge/cli/merge-cli.js --platform=node",
    "node:validate": "node --import ./scripts/node/register.js packages/cli-validate/cli/validate-cli.js --platform=node"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "ajv": "^8.20.0",
    "bun": "1.4.2",
    "esbuild": "^0.28.2",
    "fallow": "^3.25.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=23.6.0",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "browserslist": "^4.28.7"
  }
}
