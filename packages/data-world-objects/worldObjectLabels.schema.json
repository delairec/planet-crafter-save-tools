{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "worldObjectLabels.schema.json",
  "title": "World object labels",
  "description": "The display label of each world object name.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["worldObjectName", "label"],
    "additionalProperties": false,
    "properties": {
      "worldObjectName": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
      "label": {"type": "string", "minLength": 1}
    }
  }
}
