{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "legacy-save-file.schema.json",
  "title": "Planet Crafter — Parsed save file in the format of 1.618",
  "description": "Representation of a Planet Crafter save written in the format of 1.618 after parsing. Array of 12 parts (indexes 0 to 11): the Terrain layers section at index 9 shifts the world events to index 10, and part 11 is reserved. Each part is an array of JSON entries.",
  "type": "array",
  "minItems": 12,
  "maxItems": 12,
  "items": [
    {
      "title": "Section 0 — Player progression",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "section0-player-progression.schema.json" }
    },
    {
      "title": "Section 1 — Terraformation levels",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "section1-terraformation-levels.schema.json" }
    },
    {
      "title": "Section 2 — Players",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "section2-players.schema.json" }
    },
    {
      "title": "Section 3 — World objects",
      "type": "array",
      "items": { "$ref": "section3-world-objects.schema.json" }
    },
    {
      "title": "Section 4 — Inventories & equipment",
      "type": "array",
      "items": { "$ref": "section4-inventories.schema.json" }
    },
    {
      "title": "Section 5 — Statistics",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "section5-statistics.schema.json" }
    },
    {
      "title": "Section 6 — Read messages",
      "type": "array",
      "items": { "$ref": "section6-messages.schema.json" }
    },
    {
      "title": "Section 7 — Triggered story events",
      "type": "array",
      "items": { "$ref": "section7-story-events.schema.json" }
    },
    {
      "title": "Section 8 — Save configuration",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "section8-save-config.schema.json" }
    },
    {
      "title": "Section 9 — Terrain layers",
      "type": "array",
      "items": { "$ref": "legacy-section9-terrain-layers.schema.json" }
    },
    {
      "title": "Section 10 — World events",
      "type": "array",
      "items": { "$ref": "section9-world-events.schema.json" }
    },
    {
      "title": "Section 11 — Reserved",
      "type": "array",
      "maxItems": 0
    }
  ]
}
