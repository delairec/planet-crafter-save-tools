{
  "name": "core-mapping",
  "version": "1.0.0",
  "description": "Domain/application/infrastructure/presentation mapping for Planet Crafter save files",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint:types": "tsc --noEmit",
    "generate:section-validators": "bun scripts/generate-section-validators.ts",
    "check:section-validators": "bun scripts/check-section-validators.ts",
    "validate:tables": "bun ../../scripts/validate-tables/validate-tables.ts src/domain/energyLevels src/domain/energyLevelsByRelease/1.618:energyLevelsOfRelease src/domain/energyLevelsByRelease/2.004:energyLevelsOfRelease src/domain/optimizerConfig src/domain/planetNamesByNumericId src/presentation/worldObjectLabels"
  },
  "exports": {
    "./controllers/*": "./src/controllers/*.ts",
    "./presentation/viewModels/*": "./src/presentation/viewModels/*.ts"
  },
  "dependencies": {
    "shared-save-processing": "*"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
