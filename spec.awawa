		IMPL "packages/core-mapping/src/domain/rules/energyOptimizerConfig.ts"
		IMPL "packages/core-mapping/src/domain/rules/computeOptimizerBoosts.ts"
	SPEC "production, fusion : les valeurs par defaut de mergeGlobalMetadata et mergeStatistics ne"
		+ "sont plus nommees validated, l'indentation revient aux tabulations, le generateur vide"
		+ "de mergeSaveSections cesse d'etre nomme comme une constante et les dix sections sont"
		+ "destructurees par leur nom"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeGlobalMetadata.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeStatistics.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeSaveSections.ts"
	SPEC "production : le recit historique et la note de suite quittent le code des tables"
		+ "d'energie"
		IMPL "packages/core-mapping/src/domain/energyLevelsByWorldObjectName.ts"
		IMPL "packages/core-mapping/src/domain/rules/computePlanetEnergyLevels.ts"
	SPEC "presentation : les trois marqueurs de tache et la question en commentaire quittent"
		+ "worldObjectLabels.ts, et les deux doublons de cle sont tranches"
		IMPL "packages/core-mapping/src/presentation/worldObjectLabels.ts"
	SPEC "presentation : le texte utilisateur en dur des trois presenters passe dans le repertoire"
		+ "des messages du package"
		IMPL "packages/core-mapping/src/presentation/EnergyLevelsPresenter.ts"
		IMPL "packages/core-mapping/src/presentation/TerraformationLevelsPresenter.ts"
		IMPL "packages/core-mapping/src/presentation/GlobalProgressionPresenter.ts"
	SPEC "presentation : l'espace insecable est declaree une seule fois, les deux interfaces"
		+ "Threshold de meme nom sont unifiees et la table des strategies est typee par cle"
		IMPL "packages/core-mapping/src/presentation/formatters/formatNumber"
	SPEC "infrastructure : le retrait de l'extension json est partage au lieu d'etre duplique avec"
		+ "une sensibilite a la casse differente"
		IMPL "packages/core-mapping/src/infrastructure/SaveFilesMergerService.ts"
	SPEC "infrastructure : les abreviations et la note restituant ce que fait la methode quittent"
		+ "SaveSectionsReaderService"
		IMPL "packages/core-mapping/src/infrastructure/SaveSectionsReaderService.ts"
	SPEC "infrastructure : l'indice de section en dur de validateSaveContent passe par sa constante"
		+ "nommee, et le parametre par lequel passe toute save cesse de s'appeler mergedSave"
		IMPL "packages/core-mapping/src/infrastructure/validateSaveContent.js"
	SPEC "application : le port lecteur cesse de retourner un value object de progression, et les"
		+ "use cases cessent de nommer analyseur le parametre d'un port lecteur"
		IMPL "packages/core-mapping/src/application/ports/SaveSectionsReaderPort.ts"
	SPEC "specs : dix-sept tests de seize fichiers separent leurs phases d'action et d'assertion,"
		+ "que TEST-1 impose toujours presentes"
		IMPL "packages/core-mapping/src/domain/entities"
		IMPL "packages/core-mapping/src/domain/valueObjects"
	SPEC "specs : aucun titre de test ne contient when, les deux fichiers indentes en espaces"
		+ "reviennent aux tabulations, et le premier describe de determineSaveOrder perd son"
		+ "prefixe technique"
		IMPL "packages/core-mapping/src/domain/rules/merge/determineSaveOrder.spec.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeSaveSections.spec.ts"
	SPEC "specs : les assertions reprojetees assertent la valeur, les attendus sont litteraux et"
		+ "non calcules ni etales depuis une fixture"
		IMPL "packages/core-mapping/src/domain/rules/computeOptimizers.spec.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergePlayers.spec.ts"
	SPEC "specs : les appels de use case dans un test non asynchrone sont attendus, meme quand le"
		+ "corps est synchrone"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.spec.ts"
		IMPL "packages/core-mapping/src/application/ValidateSaveFile.spec.ts"
	SPEC "specs : la couverture dupliquee entre niveaux est retiree, les specs de controleur"
		+ "reviennent a un nominal et un echec, et les tests sans objet sont supprimes ou reecrits"
		IMPL "packages/core-mapping/src/controllers"
	SPEC "specs : aucun indice de section n'est ecrit en dur, pas meme dans une spec, et les casts"
		+ "sur des litteraux deja conformes sont retires"
		IMPL "packages/core-mapping/src/infrastructure/SaveFilesMergerService.spec.ts"
		IMPL "packages/core-mapping/src/presentation/LoadSaveFilePresenter.spec.ts"
	RATIONALE "decision du 2026-09-09 : les specs lisent le module d'indices de section ; le releve"
		+ "a ete mis a jour apres la revue de T26, qui a nomme tous ceux de"
		+ "validateSaveContent.spec.js"
	SPEC "specs : les deux cas manquants sont ajoutes, si T37 ne les a pas fait disparaitre"
		IMPL "packages/core-mapping/src/presentation/GlobalProgressionPresenter.spec.ts"
		IMPL "packages/core-mapping/src/presentation/SaveConfigurationPresenter.spec.ts"
	SPEC "acceptation : la porte qualite est verte avec la garde des assertions, aucune phase"
		+ "d'action et d'assertion fusionnee ne subsiste dans le package"
		IMPL "packages/core-mapping"

// Les points que T37 et T38 laissent a trancher au demarrage. Ils etaient dans la section
// « Decisions » de leur fiche, ou personne ne pouvait les compter ; ce sont des questions, avec
// une recommandation, pas des arbitrages rendus.
OPEN_QUESTION FormeDesErreursDeRegleDomaine
	DESC "sous quel type validateUniqueHost et validateFloatSerialization rendent-elles leur echec"
	DESC "recommandation : un type du domaine, que l'infrastructure traduit en issue de validation"
		+ "avec son code ; les codes restent en application, sans celui que le domaine decide"
	STATUS specified
	BLOCKS @TASK.T37
	SOURCE "fiche T37, decision 1"

OPEN_QUESTION OuVerifierLaSerialisationDesFlottants
	DESC "la verification du suffixe .0 reste-t-elle une regle de domaine"
	DESC "recommandation : non, elle sort vers l'infrastructure, a cote des schemas — la propriete"
		+ "est celle du texte"
	STATUS specified
	BLOCKS @TASK.T37
	RATIONALE "l'alternative, une regle de domaine recevant des entrees analysees et verifiant"
		+ "l'integrite du nombre, ne verifie rien : la propriete n'est pas observable apres analyse"
		+ "JSON"
	SOURCE "fiche T37, decision 2"

OPEN_QUESTION OuDecoderLEncodageDesListesDIdentifiants
	DESC "le domaine garde-t-il les chaines d'identifiants separees par des virgules, ou les"
		+ "recoit-il decodees"
	DESC "recommandation : decodage en infrastructure avant le domaine et re-encodage apres, une"
		+ "seule declaration du separateur"
	STATUS specified
	BLOCKS @TASK.T37
	RATIONALE "T11 a tranche que les DTO wire restent l'entree et la sortie du domaine ; elle n'a"
		+ "pas tranche l'analyse d'un encodage de champ dans le domaine. L'alternative est"
		+ "d'elargir explicitement cette question aux encodages de champ"
	SOURCE "fiche T37, decision 3"

OPEN_QUESTION SortDeMergedSaveValueObject
	DESC "MergedSaveValueObject est-il supprime ou renomme en type d'infrastructure"
	DESC "recommandation : supprime ; le port de fusion retourne les sections fusionnees et la"
		+ "serialisation comme le nommage du fichier restent en infrastructure"
	STATUS specified
	BLOCKS @TASK.T37
	RATIONALE "T27 a deja note que son invariant est vide : la seule erreur de domaine atteignable"
		+ "sur le chemin de fusion est un test de chaine vide sur un blob"
	SOURCE "fiche T37, decision 4"

OPEN_QUESTION FormeDuContratControleurVersUi
	DESC "comment l'UI cesse-t-elle de connaitre la representation de persistance des sections"
	DESC "recommandation : les controleurs de section recoivent le contenu texte deja valide et le"
		+ "composition root fabrique lecteur et analyseur ; l'alternative est un identifiant opaque"
		+ "de save chargee porte par le ViewModel"
	STATUS specified
	BLOCKS @TASK.T37
	BLOCKS @TASK.T32
	RATIONALE "mesure prealable de T13 : l'analyse coute 2 ms sur 2 Mo, donc la refaire par"
		+ "controleur de section ne coute rien"
	SOURCE "fiche T37, decision 6"

OPEN_QUESTION SortDesCleusDupliqueesDeWorldObjectLabels
	DESC "que faire des deux definitions de OutsideLamp1 et de la paire Keycard1 / KeyCard1,"
		+ "probablement la meme cle"
	DESC "recommandation : conserver la premiere occurrence et verifier la casse contre les saves"
		+ "de reference"
	STATUS specified
	BLOCKS @TASK.T38
	SOURCE "fiche T38, decision 2"

DECISION UneTacheFusionneeResteDansLeCorpus
	DESC "une tache fusionnee passe implemented et reste une entite ; sa fiche markdown n'est plus"
		+ "supprimee, parce qu'il n'y a plus de fiche"
	DESC "les taches fusionnees avant le 2026-09-11 ne sont pas retro-creees : le graphe ne porte"
		+ "que ce qui reste a ordonner, et leur ordre n'a plus d'effet sur rien"
	STATUS implemented
	RATIONALE "une tache ouverte nomme ses prerequis par AFTER ; si l'entite du prerequis"
		+ "disparaissait a sa fusion, la reference pendrait chez toutes celles qui l'attendaient."
		+ "Le corpus impose donc de la garder, et status --where STATUS!=implemented rend les"
		+ "ouvertes"
	RATIONALE "la raison d'etre de la suppression a la fusion — une PR fermee au lieu d'etre"
		+ "fusionnee laissait la fiche silencieusement absente — disparait : c'est le STATUS qui"
		+ "porte l'etat, plus la presence d'un fichier"
	REJECTED "supprimer l'entite a la fusion, comme la fiche l'etait : chaque suppression casserait"
		+ "les references des taches restantes"
	REJECTED "marquer la tache fusionnee superseded : le schema exige alors une arete entrante"
		+ "CLOSED_BY ou SUPERSEDED_BY, qu'une tache achevee n'a pas — elle n'a pas ete remplacee,"
		+ "elle a ete faite"
	REJECTED "retro-creer les taches deja fusionnees pour completer le graphe : leur ordre n'a plus"
		+ "d'effet sur rien"
	SPEC "le plan d'ordonnancement se lit par le corpus, plans/ ne portant plus que les vagues et"
		+ "la prose de cadrage"
		IMPL "spec.awawa"
	SOURCE "decision du 2026-09-11, migration de tasks/"

// La sécurité de l'application publiée, migrée de plans/plan-secu.md le 2026-09-12 quand ce
// fichier a été supprimé : une entité par surface protégée, et les cases à cocher devenues des
// SPEC ancrées (@DECISION.LesMesuresDeSecuriteSontDesEntitesSEC).
SCHEMA SEC
	DESC "une mesure de securite : la surface qu'elle protege, la menace qu'elle reduit, et ou elle"
		+ "est verifiee"
	DESC "specified : la mesure est requise et pas en place. implemented : elle est en place et"
		+ "ancree"
	FIELD THREAT string
		REQUIRED
		REPEATABLE
		DESC "ce qu'un attaquant obtiendrait sans cette mesure"
		FIELD REF reference
			REPEATABLE
	FIELD SCOPE repo|console
		REQUIRED
		DESC "repo : verifiable par une commande du depot. console : reglage hors depot, verifiable"
			+ "a la main seulement"

SEC TelechargementDeLaSaveFusionnee
	DESC "le fichier offert au telechargement est nomme, relu et decrit dans le navigateur, et"
		+ "n'est offert que par une action explicite"
	THREAT "un nom de fichier venu d'une save qui echappe au dossier de telechargement, masque son"
		+ "extension ou porte un caractere de controle"
	THREAT "une save exfiltree hors du navigateur par le code de l'UI"
	SCOPE repo
	STATUS implemented
	SPEC "le nom du fichier produit est normalise NFKC, reduit a un alphabet sur liste blanche,"
		+ "prive de ses points de tete, tronque a cent caracteres, et retombe sur un nom fixe s'il"
		+ "devient vide"
		IMPL "packages/core-mapping/src/infrastructure/buildMergedFileName.ts::sanitizeFileName"
		IMPL "packages/core-mapping/src/infrastructure/buildMergedFileName.spec.ts::path separators"
			+ "or unsafe characters"
	SPEC "le fichier produit garde l'extension .json et le type application/json"
		IMPL "packages/core-mapping/src/infrastructure/buildMergedFileName.ts::-merged.json"
		IMPL "packages/ui-save-manager/src/components/MergeResultSection.tsx::application/json"
	SPEC "le contenu fusionne est relu par le validateur avant d'etre offert, et les erreurs de la"
		+ "sortie sont affichees a cote du lien"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.ts::mergedSaveValidation"
		IMPL "packages/ui-save-manager/src/components/MergeResultSection.tsx::mergeResultSectionMergedSaveInvalidMessage"
	SPEC "le telechargement part d'un lien porteur de download, jamais d'un clic programme"
		IMPL "packages/ui-save-manager/src/components/MergeResultSection.tsx::download="
	SPEC "le nom du fichier est affiche avant que le lien soit suivi"
		IMPL "packages/ui-save-manager/src/components/MergeResultSection.tsx::mergeResultSectionFileCreatedMessage"
	SPEC "aucun appel reseau dans le paquet d'UI : les saves ne quittent pas le navigateur"
		IMPL "packages/ui-save-manager/src"
	RATIONALE "la relecture n'interdit pas le telechargement : une fusion qui produit un fichier"
		+ "reste un succes, et l'utilisateur voit les erreurs de la sortie a cote du lien"
		REF @DECISION.UneFusionQuiProduitUnFichierResteUnSucces
	RATIONALE "la relecture de la sortie n'existe que depuis T28, fusionnee le 2026-09-11, alors"
		+ "que la case correspondante du plan etait cochee depuis le 2026-09-08 : une case ne dit"
		+ "pas ou la mesure est realisee, une ancre le dit"
	SOURCE "plans/plan-secu.md, phase 1"

SEC EnTetesDuSitePublie
	DESC "le repertoire publie porte les en-tetes de securite du site, que l'hebergeur lit au"
		+ "deploiement"
	THREAT "un script injecte dans la page qui atteint une origine tierce ou exfiltre une save"
	THREAT "la page encadree par un site tiers, ou servie en clair"
	SCOPE repo
	STATUS implemented
	SPEC "la politique de contenu ferme la source par defaut, les connexions et les soumissions de"
		+ "formulaire a l'origine, et refuse les objets, la base d'URL et l'encadrement"
		IMPL "packages/ui-save-manager/public/_headers::Content-Security-Policy"
	SPEC "les quatre autres en-tetes sont declares : transport strict, refus du reniflage de type,"
		+ "politique de referent et politique de permissions"
		IMPL "packages/ui-save-manager/public/_headers::Strict-Transport-Security"
		IMPL "packages/ui-save-manager/public/_headers::X-Content-Type-Options"
		IMPL "packages/ui-save-manager/public/_headers::Referrer-Policy"
		IMPL "packages/ui-save-manager/public/_headers::Permissions-Policy"
	RATIONALE "les en-tetes ne valent qu'au deploiement de production : une politique appliquee en"
		+ "developpement entre en conflit avec le rechargement a chaud"
	SOURCE "plans/plan-secu.md, phase 2"

SEC ChaineDeDependancesEtDeBuild
	DESC "ce qui entre dans le bundle livre au navigateur est declare, gele et audite"
	THREAT "une dependance compromise ou vulnerable livree au navigateur par le build"
	SCOPE repo
	STATUS implemented
	SPEC "tout package consomme par l'UI est une dependance de workspace declaree, verifiee par une"
		+ "garde"
		IMPL "package.json::check:dependencies"
	SPEC "le fichier de verrouillage est versionne et l'installation de CI est gelee sur lui"
		IMPL "bun.lock"
		IMPL ".github/workflows/dependencies.yml::--frozen-lockfile"
	SPEC "l'audit de vulnerabilites tourne en CI sur chaque pull request et sur la branche par"
		+ "defaut, et echoue a partir de la severite haute"
		IMPL ".github/workflows/dependencies.yml::bun run audit"
		IMPL "package.json::--audit-level=high"
	SPEC "le suivi de versions est planifie, pour les actions de CI comme pour les dependances du"
		+ "workspace"
		IMPL ".github/dependabot.yml::package-ecosystem"
	RATIONALE "le suivi de versions ne remonte aucune vulnerabilite pour cet ecosysteme : l'audit"
		+ "est le seul filet"
		REF @DECISION.DependabotSuitDeuxEcosystemesEnGroupesHebdomadaires
	SOURCE "plans/plan-secu.md, phase 3"

SEC JetonsEtSecretsDeLaCi
	DESC "les workflows tournent avec le jeton le plus etroit qui les fasse passer, et ne portent"
		+ "aucun secret en clair"
	THREAT "un workflow detourne qui ecrit dans le depot ou lit un secret de production"
	SCOPE repo
	STATUS implemented
	SPEC "chaque workflow declare ses permissions, et aucune ne va au-dela de la lecture du contenu"
		+ "hors de celles que l'action de revue exige"
		IMPL ".github/workflows/dependencies.yml::permissions"
		IMPL ".github/workflows/quality.yml::permissions"
		IMPL ".github/workflows/ui-tests.yml::permissions"
		IMPL ".github/workflows/claude.yml::permissions"
		IMPL ".github/workflows/claude-code-review.yml::permissions"
	SPEC "aucun secret n'est ecrit dans le depot : les workflows les lisent par le magasin de"
		+ "secrets de la forge"
		IMPL ".github/workflows/claude.yml::secrets.CLAUDE_CODE_OAUTH_TOKEN"
	SOURCE "plans/plan-secu.md, phase 4"

SEC ProtectionDesComptesEtDuDeploiement
	DESC "ce qui protege la chaine de publication hors du depot : les deux comptes, la branche de"
		+ "production et le build de l'hebergeur"
	THREAT "un compte pris qui deploie en production sans passer par une revue"
	THREAT "une previsualisation de deploiement qui expose un secret de production"
	SCOPE console
	STATUS specified
	SPEC "l'authentification a deux facteurs est active sur les deux comptes et les droits"
		+ "d'administration sont limites"
	SPEC "la branche de production exige une revue et des verifications vertes"
	SPEC "l'audit est bloquant dans le build de l'hebergeur : un deploiement echoue sur une"
		+ "vulnerabilite haute ou critique"
	SPEC "les previsualisations de deploiement ne disposent d'aucun secret de production"
	SPEC "les secrets de l'hebergeur et de la forge sont limites a la portee qui les consomme"
	SPEC "les deploiements sont notifies et tracables"
	RATIONALE "aucune de ces obligations n'a d'ancre dans le depot : elle ne peut pas passer"
		+ "implemented, et c'est SCOPE console qui dit pourquoi, pas son STATUS"
	SOURCE "plans/plan-secu.md, phase 4"

OPEN_QUESTION LaPolitiqueDeContenuAutoriseLeScriptEnLigne
	DESC "la politique de contenu autorise le script et le style en ligne : un script injecte dans"
		+ "la page s'execute malgre elle"
	DESC "a trancher : hachage ou nonce sur le script d'hydratation, ou constat que le cadre ne le"
		+ "permet pas"
	STATUS specified
	BLOCKS @SEC.EnTetesDuSitePublie
	RATIONALE "la politique a ete posee compatible avec le build de production, sans que le retrait"
		+ "de l'inline soit tente ni mesure"
	RATIONALE "la case du plan restait cochee : la politique existe, et c'est sa force qui n'etait"
		+ "ecrite nulle part"
	SOURCE "relu le 2026-09-12, migration de plans/plan-secu.md, phase 2"

DECISION LeRisqueEstLIntegriteDuJavaScriptLivrePasLeTransport
	DESC "le modele de confiance : la save ne quitte pas le navigateur, donc le risque n'est pas"
		+ "son transport mais l'integrite du JavaScript que l'hebergeur livre"
	DESC "l'objectif n'est pas de rendre fiable un site compromis : reduire la probabilite de"
		+ "compromission, et en limiter les consequences"
	STATUS specified
	RATIONALE "le traitement local ecarte le serveur de la chaine de traitement, pas de la chaine"
		+ "de livraison : un script compromis fabrique un fichier malveillant ou exfiltre la save"
		+ "sans qu'un traitement local y change rien"
	REJECTED "traiter le caractere local du traitement comme suffisant"
	REJECTED "fusionner cote serveur pour maitriser le code execute : les saves quitteraient la"
		+ "machine de l'utilisateur, ce qui echange la menace contre une pire"
	SPEC "le modele de confiance est expose dans la documentation publique du depot"
	SOURCE "plans/plan-secu.md, probleme et approche"

DECISION LesMesuresDeSecuriteSontDesEntitesSEC
	DESC "plans/plan-secu.md est supprime : ses phases sont des entites SEC, une par surface"
		+ "protegee, et ses cases a cocher des SPEC falsifiables ancrees dans le depot"
	DESC "une mesure hors depot reste specified : faute d'ancre elle ne peut pas passer"
		+ "implemented, et SCOPE console dit qu'aucune commande ne la verifiera"
	STATUS implemented
	RATIONALE "une case cochee ne dit ni ou la mesure est realisee, ni ce qu'elle protege, ni ce"
		+ "qui la fragilise encore : la relecture de la sortie de fusion etait cochee trois jours"
		+ "avant d'exister, et la politique de contenu cochee sans que son autorisation du script"
		+ "en ligne soit ecrite nulle part"
		REF @OPEN_QUESTION.LaPolitiqueDeContenuAutoriseLeScriptEnLigne
	RATIONALE "la migration suit celle du journal et des fiches de defauts : un fichier dont la"
		+ "matiere a un domicile dans le corpus est supprime, pas garde en double"
		REF @DECISION.LeCorpusEstLeSeulDomicileEtHistoryEstSupprime
	REJECTED "une entite par case a cocher : vingt-huit entites sans arete, la ou une surface porte"
		+ "ses obligations comme un package porte ses SPEC"
	REJECTED "des OPEN_QUESTION pour les mesures non faites : une mesure requise et absente n'est"
		+ "pas un point non tranche, son STATUS le dit"
	REJECTED "garder le plan a cote du corpus pour la seule phase hors depot : les deux se seraient"
		+ "contredits a la premiere verification"
	SPEC "aucun fichier du contexte prive ne renvoie plus a plans/plan-secu.md"
		IMPL "AGENTS.md"
	SOURCE "decision du 2026-09-12, migration de plans/plan-secu.md"
