		IMPL "packages/core-mapping/src/domain/rules/computeEnergyBreakdown.spec.ts"
		IMPL "packages/core-mapping/src/domain/PlanetEnergyGrid.spec.ts"
		IMPL "packages/core-mapping/src/domain/entities/PlacedWorldObjectEntity.spec.ts"
	SPEC "specs : la spec de l'ordre des saves asserte le champ discriminant de la save principale,"
		+ "le litteral complet de la configuration restant chez la spec qui la fusionne"
		IMPL "packages/core-mapping/src/domain/rules/merge/determineSaveOrder.spec.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeSaveConfigurations.spec.ts"
	SOURCE "revue de code complete du 2026-09-07"
	SOURCE "arbitrage utilisateur du 2026-09-14 : trois pull requests, donc trois entites, PR #76"
	SOURCE "arbitrage utilisateur du 2026-09-14 : les deux dernieres specs porteuses sont livrees"
		+ "ici, la regle partant dans les instructions generales, PR #79"

