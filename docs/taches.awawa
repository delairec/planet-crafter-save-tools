// Les taches ouvertes. Les taches deja fusionnees ne sont pas des entites : le graphe
// ci-dessous ne porte que ce qui reste a ordonner
// (@DECISION.UneTacheFusionneeResteDansLeCorpus).
//
//   T37 ─┬─ T15 ─┐
//        └─ T32 ─┴─ T38
//              └─ T24
SHAPE task_name
	DESC "l'etiquette de la tache, un souligne, puis ce qu'elle couvre en PascalCase"
	MATCH "(T|DEP)[0-9]+_[A-Z][A-Za-z0-9]*(:v[0-9]+)?"

SCHEMA TASK
	DESC "un lot de travail qui fusionne en une ou plusieurs pull requests"
	DESC "specified : la fiche est ecrite, la tache est ouverte. implemented : elle est fusionnee,"
		+ "et elle reste"
	NAME task_name
	FIELD AFTER @TASK
		REPEATABLE
		DESC "la tache qui doit fusionner avant celle-ci ; l'arete inverse est calculee, personne"
			+ "n'ecrit BEFORE"
		CONVERSE BEFORE
	FIELD WAVE string
		DESC "la vague du plan a laquelle elle appartient"
	FIELD PR string
		REPEATABLE
		DESC "la pull request qui la livre, une fois ouverte"

TASK T37_FrontieresCleanArchitectureCoreMapping
	DESC "Clean Architecture de core-mapping : les frontieres restantes, deux PR, comportement"
		+ "inchange"
	DESC "PR A : decisions 1 a 5, un commit par decision. PR B : decision 6, le contrat controleur"
		+ "vers UI"
	STATUS specified
	WAVE "4"
	PR "62"
	RATIONALE "issue de la revue de code complete du 2026-09-07 : deux violations de la regle de"
		+ "dependance, critiques au sens de architecture/review.md, et quatre violations de"
		+ "responsabilite, toutes hors des fiches existantes"
	RATIONALE "apres T26, T27 et T28, fusionnees : elles reecrivent validateSaveContent.js,"
		+ "MergeSaveFiles.ts, les ports et presenters du merge, que la partie A touche aussi. Les"
		+ "prendre avant aurait oblige trois PR a rebaser sur un deplacement de types"
	RATIONALE "recouvrement avec T30 sur validateUniqueHost, dont T30 change le type de Player.id :"
		+ "ordre libre, rebase trivial"
	SPEC "le domaine ne depend plus de l'application : validateUniqueHost et"
		+ "validateFloatSerialization cessent d'importer VALIDATION_ISSUE_CODES et ValidationIssue"
		IMPL "packages/core-mapping/src/domain/rules/validateUniqueHost.ts"
		IMPL "packages/core-mapping/src/infrastructure/validateFloatSerialization.ts"
	SPEC "la verification du suffixe .0 ne se fait plus par expression reguliere sur le texte JSON"
		+ "dans le domaine"
		IMPL "packages/core-mapping/src/infrastructure/validateFloatSerialization.ts"
	SPEC "l'encodage liste d'identifiants separes par des virgules n'est plus analyse ni"
		+ "reserialise dans le domaine, et le separateur n'est declare qu'une fois"
		IMPL "packages/core-mapping/src/domain/rules/merge/collectEjectedPlayerInventoryIds.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/rewriteReferences.ts"
	SPEC "MergedSaveValueObject ne modelise plus un artefact de fichier dans le domaine"
		IMPL "packages/core-mapping/src/application/ports/SaveFilesMergerPort.ts"
	SPEC "aucun presenter ne decide quel resultat s'est produit : le cas section absente est choisi"
		+ "par le use case, et les ports perdent leur union avec undefined"
		IMPL "packages/core-mapping/src/presentation/SaveConfigurationPresenter.ts"
		IMPL "packages/core-mapping/src/presentation/GlobalProgressionPresenter.ts"
	SPEC "les controleurs de section n'instancient plus SaveSectionsReaderService : le composition"
		+ "root expose une fabrique"
		IMPL "packages/core-mapping/src/composition/compositionRoot.ts"
	SPEC "le ViewModel n'expose plus ParsedSections a l'UI"
		IMPL "packages/core-mapping/src/presentation/viewModels/LoadSaveFileViewModel.ts"
	SPEC "le repli sections[3] ?? [] affecte a un champ type fabrique de generateur est supprime ou"
		+ "type"
		IMPL "packages/core-mapping/src/infrastructure/SaveSectionsReaderService.ts"
	RATIONALE "tsc l'accepte parce que l'operande gauche n'est pas nullable ; si le repli etait"
		+ "pris, l'appel de la fabrique leverait une TypeError. Mort ou faux"
	SPEC "acceptation : aucun import d'application dans domain, aucun import d'infrastructure dans"
		+ "controllers hors composition et specs, aucun ViewModel important ParsedSections"
		IMPL "packages/core-mapping/src/domain"
		IMPL "packages/core-mapping/src/controllers"
	SPEC "acceptation : sortie de la fusion identique a la reference sur les deux dossiers"
		+ "d'entree, verdicts de validation identiques, tests et type-check verts"
		IMPL "packages/core-mapping/package.json::core-mapping"

TASK T15_EntitesDuDomaineEnClasses
	DESC "convertir les cinq entites du domaine en classes, les onze value objects restant des"
		+ "enregistrements readonly"
	DESC "une entite par commit, dans l'ordre WorldObject, Inventory, PlacedWorldObject, Player,"
		+ "TerraformationLevel"
	STATUS specified
	WAVE "4"
	AFTER @TASK.T37_FrontieresCleanArchitectureCoreMapping
	RATIONALE "T37 laisse en place les entites que T15 convertit et sa partie A deplace des types"
		+ "du domaine ; a executer en dernier des taches domaine"
	RATIONALE "les value objects restent des enregistrements readonly plus factory createXxx : ce"
		+ "sont des resultats de calcul ou des lectures de configuration, sans comportement propre"
	RATIONALE "champs private readonly TypeScript et non champs prives natifs : avec des champs"
		+ "natifs une instance n'a aucune propriete propre enumerable, et toEqual entre deux"
		+ "instances de valeurs differentes passerait. Le depot n'utilise jamais toStrictEqual."
		+ "Verifie sur Bun"
	RATIONALE "le spread perd le prototype : les quatre sites qui etalent une entite sont reecrits"
		+ "en construction explicite"
	SPEC "les cinq entites sont des classes a champs private readonly, accesseurs get, validation"
		+ "dans le constructeur levant InvalidSaveDataError"
		IMPL "packages/core-mapping/src/domain/entities"
	SPEC "trois comportements migrent sur les entites : summarize sur TerraformationLevelEntity,"
		+ "isWithinRadius sur PlacedWorldObjectEntity, contains sur InventoryEntity"
		IMPL "packages/core-mapping/src/domain/entities"
	SPEC "les deux use cases de section construisent leurs value objects par factory et non par"
		+ "litteral et spread"
		IMPL "packages/core-mapping/src/application/LoadEnergyLevelsSection.ts"
		IMPL "packages/core-mapping/src/application/LoadTerraformationLevelsSection.ts"
	SPEC "acceptation : aucune fabrique createXxxEntity ne subsiste, aucun champ prive natif dans"
		+ "domain/entities, aucun spread d'entite ou de value object dans domain/rules et"
		+ "application"
		IMPL "packages/core-mapping/src/domain/entities"
	SPEC "acceptation : computeTerraformationSummary et son spec sont supprimes, distanceBetween"
		+ "est absent de domain/rules ou prive"
		IMPL "packages/core-mapping/src/domain/rules"

TASK T32_ConformiteUiSaveManager
	DESC "conformite de ui-save-manager : idiomes Solid, messages, duplication ; aucun changement"
		+ "de comportement visible"
	STATUS specified
	WAVE "4"
	AFTER @TASK.T37_FrontieresCleanArchitectureCoreMapping
	RATIONALE "issue de la revue de code complete du 2026-09-07 ; travail de conformite STD-3 et"
		+ "ARCH-4"
	RATIONALE "apres T20, T27 et T31, fusionnees, qui reecrivent routes/index.tsx,"
		+ "useLoadSaveFile.ts, MergeSection.tsx et ValidationMessagesList.tsx ; la partie B de T37"
		+ "change le contrat controleur vers UI dont T32 part"
	RATIONALE "de preference apres T17, qui etend le type-check aux fichiers tsx, pour que les"
		+ "corrections soient verifiees par tsc"
	RATIONALE "l'etat des lieux note que la matrice de dependances est respectee, qu'il n'y a aucun"
		+ "appel reseau, que l'objet-URL est revoque a chaque resultat et au demontage, et que le"
		+ "nom du fichier telecharge est normalise en infrastructure de core-mapping"
	SPEC "la liste des messages de validation est rendue par le primitif de liste de Solid et non"
		+ "par un map dans le JSX"
		IMPL "packages/ui-save-manager/src/components/validation/ValidationMessagesList.tsx"
	RATIONALE "rendue une fois, elle ne se met plus a jour ; masque aujourd'hui parce que les"
		+ "appelants demontent et remontent le bloc"
	SPEC "aucun composant ne destructure ses props en signature : la reactivite est perdue a tout"
		+ "changement de prop"
		IMPL "packages/ui-save-manager/src/components"
	SPEC "acceptation : aucun map rendant du JSX, aucune prop destructuree en signature, aucune"
		+ "assertion non nulle sous un affichage conditionnel dans src"
		IMPL "packages/ui-save-manager/src"
	SPEC "acceptation : aucune chaine utilisateur hors du repertoire des messages, hors attributs"
		+ "techniques"
		IMPL "packages/ui-save-manager/src"
	SPEC "acceptation : une seule definition de ColumnViewModel dans le depot"
		IMPL "packages/ui-save-manager/src"
	SPEC "acceptation : la build de l'UI est verte, le type-check l'est une fois T17 fusionnee"
		IMPL "packages/ui-save-manager/package.json::ui-save-manager"

TASK T24_HarnaisDeTestsUiParScenarios
	DESC "harnais complet de tests d'UI par scenarios, quatre livrables, chacun fusionnable seul"
	DESC "derniere tache UI a fusionner : chaque tache UI qui la precede peut deplacer un libelle"
		+ "et casser un locator"
	STATUS specified
	WAVE "4"
	AFTER @TASK.T32_ConformiteUiSaveManager
	RATIONALE "T23 a pose le runner, la configuration, le serveur, la convention de nommage, la"
		+ "premiere fixture et le workflow CI ; T24 n'ajoute que des scenarios et l'outillage de"
		+ "fixtures qui les alimente"
	RATIONALE "T13 est necessaire au livrable qui verifie le spinner, l'etat de section et"
		+ "l'indicateur global ; T18 pour que les scenarios d'avertissement attendent une phrase en"
		+ "clair et non un code ; T20 pour la localisation affichee des erreurs de validation"
	RATIONALE "l'etat des lieux date du 2026-09-06, avant l'execution de T23 : a reauditer au"
		+ "demarrage, les libelles et la structure de la liste des messages ayant change"
	RATIONALE "T24 ne bloque aucune autre tache"
	SPEC "les deux flux critiques sont couverts de bout en bout : afficher une save, fusionner deux"
		+ "saves et recuperer le fichier produit"
		IMPL "packages/ui-save-manager"
	SPEC "le contenu du fichier telecharge est verifie, pas seulement la presence du lien"
		IMPL "packages/ui-save-manager"
	SPEC "aucun scenario ne rejoue une regle de merge ou de validation deja couverte dans"
		+ "core-mapping : la revue le verifie fiche en main"
		IMPL "packages/core-mapping/src/domain/rules"
	SPEC "regenerer les fixtures ne produit aucun ecart avec les fichiers versionnes, et un ecart"
		+ "introduit volontairement fait echouer le controle"
		IMPL "packages/ui-save-manager"
	SPEC "la suite ne depend d'aucun fichier du repertoire d'entree et passe sur une machine sans"
		+ "acces au depot prive"
		IMPL "packages/ui-save-manager"
	SPEC "aucun identifiant de test ni selecteur CSS ajoute, aucune capture de reference"
		IMPL "packages/ui-save-manager"
	SPEC "la duree totale de la suite est mesuree et consignee dans la PR du quatrieme livrable"
		IMPL "packages/ui-save-manager"

TASK T38_ConformiteCoreMapping
	DESC "conformite de core-mapping aux standards de code et de tests : tout ce qui viole STD ou"
		+ "TEST-1 sans relever d'une fiche existante ni de T37"
	DESC "decoupable en trois PR : production, specs de domaine, specs d'application,"
		+ "d'infrastructure et de presentation"
	STATUS specified
	WAVE "4"
	AFTER @TASK.T15_EntitesDuDomaineEnClasses
	AFTER @TASK.T37_FrontieresCleanArchitectureCoreMapping
	RATIONALE "issue de la revue de code complete du 2026-09-07 ; aucun changement de comportement"
	RATIONALE "derniere des taches core-mapping : les precedentes reecrivent la plupart des"
		+ "fichiers listes, et la prendre avant reviendrait a corriger des lignes qu'elles"
		+ "suppriment"
	RATIONALE "l'etat des lieux est a reauditer au demarrage : la moitie des constats aura disparu"
		+ "avec les taches precedentes. Les ancres ci-dessous le disent — un constat dont le"
		+ "fichier n'existe plus tombe en L016"
	SPEC "production, domaine : accolades sur les if de validateUniqueHost, abreviations hors DTO"
		+ "dans resolvePlanetName, code mort de computeOptimizers, cast inutile de"
		+ "energyOptimizerConfig, forme anonyme ecrite deux fois dans computeOptimizerBoosts"
		IMPL "packages/core-mapping/src/domain/rules/validateUniqueHost.ts"
		IMPL "packages/core-mapping/src/domain/rules/resolvePlanetName.ts"
		IMPL "packages/core-mapping/src/domain/rules/computeOptimizers.ts"
		IMPL "packages/core-mapping/src/domain/rules/energyOptimizerConfig.ts"
		IMPL "packages/core-mapping/src/domain/rules/computeOptimizerBoosts.ts"
	SPEC "production, fusion : les valeurs par defaut de mergeGlobalMetadata et mergeStatistics ne"
		+ "sont plus nommees validated, l'indentation revient aux tabulations, le generateur vide"
		+ "de mergeSaveSections cesse d'etre nomme comme une constante et les dix sections sont"
		+ "destructurees par leur nom"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeGlobalMetadata.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeStatistics.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeSaveSections.ts"
	SPEC "production : le recit historique et la note de suite quittent le code des tables"
		+ "d'energie"
		IMPL "packages/core-mapping/src/domain/energyLevelsByWorldObjectName.ts"
		IMPL "packages/core-mapping/src/domain/rules/computePlanetEnergyLevels.ts"
	SPEC "presentation : les trois marqueurs de tache et la question en commentaire quittent"
		+ "worldObjectLabels.ts, et les deux doublons de cle sont tranches"
		IMPL "packages/core-mapping/src/presentation/worldObjectLabels.ts"
	SPEC "presentation : le texte utilisateur en dur des trois presenters passe dans le repertoire"
		+ "des messages du package"
		IMPL "packages/core-mapping/src/presentation/EnergyLevelsPresenter.ts"
		IMPL "packages/core-mapping/src/presentation/TerraformationLevelsPresenter.ts"
		IMPL "packages/core-mapping/src/presentation/GlobalProgressionPresenter.ts"
	SPEC "presentation : l'espace insecable est declaree une seule fois, les deux interfaces"
		+ "Threshold de meme nom sont unifiees et la table des strategies est typee par cle"
		IMPL "packages/core-mapping/src/presentation/formatters/formatNumber"
	SPEC "infrastructure : le retrait de l'extension json est partage au lieu d'etre duplique avec"
		+ "une sensibilite a la casse differente"
		IMPL "packages/core-mapping/src/infrastructure/SaveFilesMergerService.ts"
	SPEC "infrastructure : les abreviations et la note restituant ce que fait la methode quittent"
		+ "SaveSectionsReaderService"
		IMPL "packages/core-mapping/src/infrastructure/SaveSectionsReaderService.ts"
	SPEC "infrastructure : l'indice de section en dur de validateSaveContent passe par sa constante"
		+ "nommee, et le parametre par lequel passe toute save cesse de s'appeler mergedSave"
		IMPL "packages/core-mapping/src/infrastructure/validateSaveContent.js"
	SPEC "application : le port lecteur cesse de retourner un value object de progression, et les"
		+ "use cases cessent de nommer analyseur le parametre d'un port lecteur"
		IMPL "packages/core-mapping/src/application/ports/SaveSectionsReaderPort.ts"
	SPEC "specs : dix-sept tests de seize fichiers separent leurs phases d'action et d'assertion,"
		+ "que TEST-1 impose toujours presentes"
		IMPL "packages/core-mapping/src/domain/entities"
		IMPL "packages/core-mapping/src/domain/valueObjects"
	SPEC "specs : aucun titre de test ne contient when, les deux fichiers indentes en espaces"
		+ "reviennent aux tabulations, et le premier describe de determineSaveOrder perd son"
		+ "prefixe technique"
		IMPL "packages/core-mapping/src/domain/rules/merge/determineSaveOrder.spec.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergeSaveSections.spec.ts"
	SPEC "specs : les assertions reprojetees assertent la valeur, les attendus sont litteraux et"
		+ "non calcules ni etales depuis une fixture"
		IMPL "packages/core-mapping/src/domain/rules/computeOptimizers.spec.ts"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergePlayers.spec.ts"
	SPEC "specs : les appels de use case dans un test non asynchrone sont attendus, meme quand le"
		+ "corps est synchrone"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.spec.ts"
		IMPL "packages/core-mapping/src/application/ValidateSaveFile.spec.ts"
	SPEC "specs : la couverture dupliquee entre niveaux est retiree, les specs de controleur"
		+ "reviennent a un nominal et un echec, et les tests sans objet sont supprimes ou reecrits"
		IMPL "packages/core-mapping/src/controllers"
	SPEC "specs : aucun indice de section n'est ecrit en dur, pas meme dans une spec, et les casts"
		+ "sur des litteraux deja conformes sont retires"
		IMPL "packages/core-mapping/src/infrastructure/SaveFilesMergerService.spec.ts"
		IMPL "packages/core-mapping/src/presentation/LoadSaveFilePresenter.spec.ts"
	RATIONALE "decision du 2026-09-09 : les specs lisent le module d'indices de section ; le releve"
		+ "a ete mis a jour apres la revue de T26, qui a nomme tous ceux de"
		+ "validateSaveContent.spec.js"
	SPEC "specs : les deux cas manquants sont ajoutes, si T37 ne les a pas fait disparaitre"
		IMPL "packages/core-mapping/src/presentation/GlobalProgressionPresenter.spec.ts"
		IMPL "packages/core-mapping/src/presentation/SaveConfigurationPresenter.spec.ts"
	SPEC "acceptation : la porte qualite est verte avec la garde des assertions, aucune phase"
		+ "d'action et d'assertion fusionnee ne subsiste dans le package"
		IMPL "packages/core-mapping"

DECISION UneTachePorteSonEtiquetteEtUnNomLisible
	DESC "le nom d'une tache est son etiquette, un souligne, puis ce qu'elle couvre :"
		+ "T37_FrontieresCleanArchitectureCoreMapping"
	DESC "l'etiquette reste le prefixe stable et la forme courte employee en prose, dans les"
		+ "SOURCE, les messages de commit et les noms de branche"
	STATUS implemented
	RATIONALE "une tache nommee par sa seule etiquette obligeait status TASK, refs et le pied de"
		+ "page de context a etre relus fiche par fiche pour savoir de quoi ils parlaient : le"
		+ "listing ne portait aucune information"
	RATIONALE "le shape de nom est declare sur SCHEMA TASK, donc fmt --rename refuse un nom qui le"
		+ "manque et lint le signale : la convention ne depend plus de la memoire de la session"
	REJECTED "remplacer l'etiquette par le nom seul : l'etiquette est citee dans les branches, les"
		+ "pull requests et les revues deja ecrites"
	REJECTED "porter le nom dans un champ plutot que dans l'identite : status et refs impriment"
		+ "l'identite, pas un champ, et le probleme resterait entier"
	REJECTED "separer l'etiquette du nom par un point : le point porte une portee par convention,"
		+ "et T37 n'est pas la portee de son nom"
	SPEC "le nom de toute tache est accepte par le shape task_name, la famille d'outillage DEP"
		+ "comprise"
		IMPL "docs/taches.awawa::SHAPE task_name"
	SOURCE "decision du 2026-09-12, apres le decoupage du corpus par domaine"

DECISION UneTacheFusionneeResteDansLeCorpus
	DESC "une tache fusionnee passe implemented et reste une entite ; sa fiche markdown n'est plus"
		+ "supprimee, parce qu'il n'y a plus de fiche"
	DESC "les taches fusionnees avant le 2026-09-11 ne sont pas retro-creees : le graphe ne porte"
		+ "que ce qui reste a ordonner, et leur ordre n'a plus d'effet sur rien"
	STATUS implemented
	RATIONALE "une tache ouverte nomme ses prerequis par AFTER ; si l'entite du prerequis"
		+ "disparaissait a sa fusion, la reference pendrait chez toutes celles qui l'attendaient."
		+ "Le corpus impose donc de la garder, et status --where STATUS!=implemented rend les"
		+ "ouvertes"
	RATIONALE "la raison d'etre de la suppression a la fusion — une PR fermee au lieu d'etre"
		+ "fusionnee laissait la fiche silencieusement absente — disparait : c'est le STATUS qui"
		+ "porte l'etat, plus la presence d'un fichier"
	REJECTED "supprimer l'entite a la fusion, comme la fiche l'etait : chaque suppression casserait"
		+ "les references des taches restantes"
	REJECTED "marquer la tache fusionnee superseded : le schema exige alors une arete entrante"
		+ "CLOSED_BY ou SUPERSEDED_BY, qu'une tache achevee n'a pas — elle n'a pas ete remplacee,"
		+ "elle a ete faite"
	REJECTED "retro-creer les taches deja fusionnees pour completer le graphe : leur ordre n'a plus"
		+ "d'effet sur rien"
	SPEC "le plan d'ordonnancement se lit par le corpus, plans/ ne portant plus que les vagues et"
		+ "la prose de cadrage"
		IMPL "docs/taches.awawa"
	SOURCE "decision du 2026-09-11, migration de tasks/"
