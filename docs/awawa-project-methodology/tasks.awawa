		IMPL "package.json::check:anchors"
	SPEC "the guard covers every field the schema declares as an anchor, read from the schema and"
		+ "not from a list written in the script"
		IMPL "scripts/check-corpus-anchors.ts::export function readAnchorFields"
		IMPL "scripts/check-corpus-anchors.spec.ts::describe('readAnchorFields'"
	SPEC "check:anchors is called by check:guards, as the seven guards already there are"
		IMPL "package.json::&& bun run check:anchors"
	SPEC "a spec file pins the guard on a tracked path, on an untracked one and on a path that does"
		+ "not exist at all"
		IMPL "scripts/check-corpus-anchors.spec.ts::describe('findUntrackedCorpusAnchors'"
	DELIVERED_BY 101
