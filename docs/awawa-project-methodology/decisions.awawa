DECISION ConsumerVersionsAreComputedByARepositoryScript
	SPEC "Only the cli-* and ui-* packages carry a version a release raises"
		IMPL "scripts/release/resolveConsumerPaths.ts::CONSUMER_PREFIXES"
	SPEC "A consumer takes a new version when a first-parent commit of master since its last tag"
		+ "changes its directory or that of a workspace package it depends on transitively"
		IMPL "scripts/release/resolveConsumerPaths.ts::collectReachableDirectories"
		IMPL "scripts/release/readCommitSubjects.ts::--first-parent"
		ENFORCED_BY "scripts/release/readCommitSubjects.spec.ts"
	SPEC "Below 1.0.0, a ! raises the minor number and any other subject the patch number; a"
		+ "release never leaves 0"
		IMPL "scripts/release/planRelease.ts::lowerIncrementBeforeFirstMajor"
		ENFORCED_BY "scripts/release/planRelease.spec.ts"
	SPEC "From 1.0.0 on, a ! raises the major number, feat the minor one, any other subject the"
		+ "patch number"
		IMPL "scripts/release/planRelease.ts::determineIncrement"
		ENFORCED_BY "scripts/release/planRelease.spec.ts"
	SPEC "A version is a tag <consumer>-v<version> set on master after the release pull request is"
		+ "merged"
		IMPL "scripts/release/release-tag.ts::RELEASE_BRANCH"
	SPEC "The tag of a version names the first-parent commit of master that wrote that version into"
		+ "the manifest, whatever was merged after it"
		IMPL "scripts/release/findVersionCommit.ts::--first-parent"
		ENFORCED_BY "scripts/release/findVersionCommit.spec.ts"
	SPEC "A release refuses a consumer whose declared version, other than 0.0.0, carries no tag"
		IMPL "scripts/release/findVersionsToTag.ts::INITIAL_VERSION"
		ENFORCED_BY "scripts/release/findVersionsToTag.spec.ts"
	REJECTED "release-please in manifest mode: no released version counts the paths of another"
		+ "package, so core-mapping and the shared packages would carry versions too; refactor,"
		+ "test and chore commits raise nothing; bun.lock is left stale"
	REJECTED "changesets: a file written by hand in every pull request, and a dependency that"
		+ "carries no version does not propagate its release to its dependents"
	REJECTED "Nx release and lerna-lite: both version the dependencies too, and Nx means adopting a"
		+ "build system"
	REJECTED "Deciding a bump from the scope of the commit: scopes name corpus areas and guards as"
		+ "often as packages"
	REJECTED "Starting the consumers at 1.0.0: much of the product is not settled yet"
	RATIONALE "A version exists so that a bug report names what ran; what runs is a consumer and"
		+ "every workspace package it bundles, and only the paths a commit changes say which"
	APPLIES_TO_TASK @TASK.CHORE83
	SOURCE "Ruled with the user on 2026-09-23 after the comparison CHORE83 asks for"
