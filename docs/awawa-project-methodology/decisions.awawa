	SPEC "A machine whose only known energy is a hypothesis of no power stays out of the energy"
		+ "table, in the same group as a machine with an unprinted value, and is not counted among"
		+ "the placed machines whose energy is unknown"
		IMPL "packages/core-mapping/src/domain/worldObjectNames.ts::WORLD_OBJECT_NAMES_WITHOUT_KNOWN_ENERGY_LEVEL"
