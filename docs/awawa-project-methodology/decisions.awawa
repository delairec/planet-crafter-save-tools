DECISION NodeCommandsRunSourcesThroughModuleHooks
	SPEC "Node commands run the repository sources through Node module customization hooks: a"
		+ "resolve hook tries both extensions, a load hook hands TypeScript modules to a"
		+ "transformer"
		IMPL "scripts/node/hooks.js"
