	REJECTED "One pivot for the whole workspace: the two areas answer two questions"

DECISION TheEraIsNotTheArchive
	SPEC "A SECTION the game stopped writing stays active and names by HOLDS_FOR the releases that"
		+ "wrote it; STATUS archived is written only when the project stops supporting what the"
		+ "entity describes"
		IMPL "docs/_schema.awawa::FIELDSET ReleaseScope"
		IMPL "agents/corpus-ecrire.md::L'ère n'est pas l'archive"
	SPEC "An entity lints clean before it is archived, and nothing active still points at it"
		IMPL "docs/_schema.awawa::WHEN STATUS archived"
	SPEC "PURGE keeps its default on a specification entity"
		IMPL "docs/_schema.awawa::FIELD PURGE true|false"
	REJECTED "Archiving a section the game removed: its rules still bind older saves"
	REJECTED "PURGE false by default on the specification types: the archive would become history"
	REJECTED "A two-valued era on a section: it cannot say which releases wrote it"
	RATIONALE "GATE suppressed turns off every check of an archived entity and removes its body"
		+ "from the context packages citing it"

DECISION AnAnchorNamesAFileTrackedByGit
	SPEC "Every anchor of an active entity names a file git tracks, never a path under input,"
		+ "output or .do-not-commit"
