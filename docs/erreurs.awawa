// Les erreurs, les avertissements, et le texte que l'utilisateur lit.
DECISION LOrigineDUneErreurDecideDuCheminQuElleEmprunte
	DESC "une erreur sur un fichier d'entree que l'outil ne modifie pas releve de la validation,"
		+ "qui s'execute d'abord ; la meme erreur surgissant plus loin est un invariant rompu et"
		+ "echoue bruyamment"
	DESC "une erreur que l'outil cree par sa propre intervention — fusion, renumerotation,"
		+ "serialisation, ecriture — atteint l'UI et le CLI par une issue de presenter en langage"
		+ "metier, jamais par une exception"
	DESC "une issue de presenter par famille d'erreur, jamais une issue generique : reutiliser"
		+ "l'issue des fichiers d'entree dirait a l'utilisateur que ses saves sont mauvaises alors"
		+ "que c'est l'outil qui a echoue"
	DESC "le rattrapage est type sur l'erreur de domaine, jamais sur unknown : tout le reste"
		+ "continue de remonter en exception"
	STATUS implemented
	RATIONALE "une erreur d'analyse rencontree par le fusionneur porte sur les deux fichiers"
		+ "d'entree, que la validation vient d'accepter une ligne plus haut : c'est un invariant"
		+ "rompu, et aucune issue de presenter n'est ajoutee pour elle"
	RATIONALE "ce que l'utilisateur voit d'une save corrompue reste le refus de la validation,"
		+ "avant toute fusion et toute ecriture"
	REJECTED "une issue de presenter generique portant n'importe quelle erreur"
	REJECTED "convertir en issue toute erreur rattrapee, quelle que soit sa famille"
	REJECTED "faire remonter par exception une erreur nee de l'intervention de l'outil"
	SPEC "les invariants de l'infrastructure de core-mapping vivent dans un repertoire d'erreurs"
		+ "nommees"
		IMPL "packages/core-mapping/src/infrastructure/errors"
	SOURCE "decision du 2026-09-07, revue de T26 ; seconde moitie livree par T27 et T28"

DECISION UnInvariantRompuEchoueParUnTypeNomme
	DESC "un invariant rompu de l'infrastructure de core-mapping echoue par un type d'erreur nomme,"
		+ "jamais par une erreur nue"
	DESC "la JSDoc de l'erreur porte la consigne, pas seulement la cause : corriger ce qui a laisse"
		+ "passer la donnee, jamais assouplir la garde"
	DESC "portee : cette couche. Les autres packages gardent leur erreur nue tant qu'ils n'ont ni"
		+ "repertoire d'erreurs ni second cas a aligner"
	STATUS implemented
	RATIONALE "les invariants d'une meme couche doivent se rattraper et se distinguer d'un bug de"
		+ "programmation de la meme facon ; la spec verifie le type puis le message"
	RATIONALE "le repli silencieux qui ecartait une section mal formee par sa forme est ce qui"
		+ "avait laisse une section entiere sans validation pendant tout ce temps : une section"
		+ "attendue en tableau qui n'en est pas un leve desormais"
	REJECTED "lever une erreur nue et distinguer les cas par le message"
	REJECTED "un repli silencieux sur la forme de la section"
	SPEC "chaque invariant de la couche a son type dans le repertoire d'erreurs"
		IMPL "packages/core-mapping/src/infrastructure/errors"
	SOURCE "decision du 2026-09-10, revue de T39, PR #48"

DECISION LaValidationEstLaSourceUniqueDesAvertissements
	DESC "le resultat de validation porte les avertissements, jamais l'analyseur"
	DESC "la validation s'execute en premier dans les quatre flux — affichage, fusion dans l'UI,"
		+ "fusion en ligne de commande, validation en ligne de commande — et les avertissements"
		+ "remontent sur toutes les issues, saves invalides et fusions reussies comprises"
	STATUS implemented
	RATIONALE "deux producteurs d'avertissements, c'est deux listes a reconcilier par consommateur"
		+ "et un flux qui en oublie une"
	REJECTED "faire porter les avertissements par le port d'analyse"
	SPEC "le port d'analyse ne declare aucun champ d'avertissements"
		IMPL "packages/core-mapping/src/application/ports"
	SOURCE "decision du 2026-09-06, T18"

DECISION LeTexteUtilisateurVitDansLaPresentationDeCoreMapping
	DESC "un code interne — avertissement, echec de fusion — est traduit en phrase par la"
		+ "presentation de core-mapping ; le ViewModel expose des chaines pretes a afficher"
	DESC "une issue qui ne transporte aucun texte a sa phrase fixe dans le repertoire des messages"
		+ "; une issue qui porte deja ses messages n'en recoit pas une de plus"
	DESC "un code inconnu tombe sur un message generique, et le code lui-meme n'est jamais affiche"
	STATUS implemented
	RATIONALE "traduire dans l'UI dupliquerait la table pour le CLI et mettrait de la connaissance"
		+ "du domaine dans un mecanisme de livraison"
	RATIONALE "un libelle fixe de plus dans le ViewModel, quand l'issue porte deja ses messages,"
		+ "doublerait le titre que chaque mecanisme de livraison ecrit deja"
	REJECTED "traduire les codes dans l'UI"
	REJECTED "afficher le code interne faute de phrase"
	REJECTED "donner une phrase d'accompagnement a une issue qui transporte deja ses messages"
	SPEC "les phrases utilisateur de core-mapping vivent dans un seul repertoire"
		IMPL "packages/core-mapping/src/presentation/messages"
	SOURCE "decision du 2026-09-06, T18 ; complete par T27 et T28"

DECISION UneLocalisationEstUnLibelleMetierSuiviDeLIndex
	DESC "un message de validation voyage comme un couple message plus localisation, la"
		+ "localisation valant nul quand l'erreur porte sur le fichier entier"
	DESC "la localisation est un libelle metier suivi de l'index — le libelle pour comprendre,"
		+ "l'index pour retrouver la section dans un editeur de texte ; le segment d'entree"
		+ "disparait quand l'erreur ne vise pas une entree, et une section hors table retombe sur"
		+ "son numero"
	DESC "elle est formatee en presentation, a cote des autres formateurs de message ; le ViewModel"
		+ "n'expose jamais les index bruts"
	DESC "un avertissement et une erreur portent le meme ViewModel : seul le champ qui les porte"
		+ "dit laquelle des deux severites c'est"
	STATUS implemented
	RATIONALE "garder les index bruts dans le ViewModel obligerait le CLI et l'UI a appeler"
		+ "eux-memes le formateur, donc a l'exporter de core-mapping, ce que la regle d'exports"
		+ "interdit"
	RATIONALE "message et localisation restent deux champs distincts : chaque mecanisme de"
		+ "livraison choisit de l'afficher ou non, et ou"
	REJECTED "l'index seul, qui est un detail de format de fichier"
	REJECTED "le libelle seul, trop pauvre pour editer la save a la main"
	REJECTED "garder les index bruts dans le ViewModel"
	SPEC "la table des libelles de section est complete, et un test d'exhaustivite echoue des"
		+ "qu'une section y manque"
		IMPL "packages/core-mapping/src/presentation/messages"
	SOURCE "decision du 2026-09-07, T20, PR #37"

DECISION LesDeuxListesDeMessagesGardentLeMemeRendu
	DESC "la distinction entre erreurs et avertissements est portee par la separation des deux"
		+ "listes, jamais par un parametrage du composant"
	DESC "un message de validation se lit comme une frame de pile : tout l'item en monospace, le"
		+ "message sur la premiere ligne, son origine en dessous, prefixee et indentee, dans un ton"
		+ "un cran plus efface que le message"
	DESC "le mot qui introduit l'origine est destine a l'utilisateur, donc il vit dans les messages"
		+ "de l'UI ; la mise en page est en CSS, et core-mapping ne sait rien du rendu"
	STATUS implemented
	RATIONALE "repliable et monospace n'est pas une option offerte au consommateur : c'est le rendu"
		+ "unique des deux listes, et les parametres qui l'avaient ouvert ont ete retires"
	RATIONALE "la premiere forme — localisation avant le message, en texte estompe hors du bloc de"
		+ "code — a ete refusee en revue sur capture : deux typographies sur une ligne. La forme"
		+ "retenue regle aussi l'ordre, une pile mettant le message d'abord"
	REJECTED "parametrer le composant de liste par severite"
	REJECTED "placer la localisation avant le message"
	SPEC "un seul composant rend les deux listes"
		IMPL "packages/ui-save-manager/src/components/validation/ValidationMessagesList.tsx"
	SOURCE "decision du 2026-09-08, revue de T20, PR #37"

DECISION UnSeulIdiomeDErreurDUiDansLePackage
	DESC "un appel de controleur qui n'aboutit pas pose un signal d'erreur local, journalise le"
		+ "detail technique, et affiche une phrase fixe vivant dans les messages du package"
	DESC "l'avis d'echec s'affiche a cote des champs de saisie, sous le bouton qui l'a produit,"
		+ "jamais dans la zone reservee a ce qu'une analyse reussie a produit"
	DESC "les deux mecanismes coexistent sans se recouvrir : l'issue de presenter dit ce que"
		+ "l'operation a decide, le signal d'UI dit que l'appel n'a pas abouti"
	STATUS implemented
	RATIONALE "arbitrage de l'utilisateur : placer l'avis dans la zone de visualisation le faisait"
		+ "tomber a environ 670 px sous le bouton qui l'avait produit, donc hors ecran sur une"
		+ "fenetre courte, et pretait a confusion avec un resultat d'analyse"
	RATIONALE "le rattrapage nu sans journal etait une omission, pas un arbitrage : verifie dans"
		+ "les trois endroits ou la justification aurait vecu, aucun n'en parle"
	REJECTED "placer l'avis d'echec a l'emplacement des messages de validation"
	REJECTED "laisser un rattrapage nu qui ne journalise rien"
	SPEC "les deux flux d'UI partagent le mecanisme, le nommage et le placement"
		IMPL "packages/ui-save-manager/src"
	SOURCE "decision du 2026-09-10, T31, PR #58 ; placement arbitre en revue"
