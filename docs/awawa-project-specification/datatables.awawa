DATATABLE EnergyLevels
	TABLE "packages/data-energy/energyLevels.json"
	KEY worldObjectName
	JSON_SCHEMA "packages/data-energy/energyLevels.schema.json"
	DESC "base kW a positioned world object produces or consumes, before any optimizer bonus, in"
		+ "the last release of the releases table"

DATATABLE WorldObjectLabels
	TABLE "packages/data-world-objects/worldObjectLabels.json"
	KEY worldObjectName
	JSON_SCHEMA "packages/data-world-objects/worldObjectLabels.schema.json"
	DESC "the display label of each world object name"

DATATABLE OptimizerConfiguration
	TABLE "packages/data-world-objects/optimizerConfig.json"
	KEY worldObjectName
	JSON_SCHEMA "packages/data-world-objects/optimizerConfig.schema.json"
	DESC "fuse slots, capacity in boosted machines and radius in meters of each optimizer tier"

DATATABLE PlanetNamesByNumericId
	TABLE "packages/data-planets/planetNamesByNumericId.json"
	KEY numericId
	JSON_SCHEMA "packages/data-planets/planetNamesByNumericId.schema.json"
	DESC "the textual planet id each numeric planet id stands for"

DATATABLE LegacyTerrainLayerProperties
	TABLE "packages/data-save-format/legacyTerrainLayerProperties.json"
	KEY property
	JSON_SCHEMA "packages/data-save-format/legacyTerrainLayerProperties.schema.json"
	DESC "the properties of an entry of the Terrain Layers section a legacy save carries"

DATATABLE GameReleases
	TABLE "packages/data-save-format/gameReleases.json"
	KEY release
	JSON_SCHEMA "packages/data-save-format/gameReleases.schema.json"
	DESC "the game releases HOLDS_FOR names, in release order, with the number of parts the saves"
		+ "each writes split into"

DATATABLE EnergyLevelsOfRelease2004
	TABLE "packages/data-energy/energyLevelsByRelease/2.004.json"
	KEY worldObjectName
	JSON_SCHEMA "packages/data-energy/energyLevelsByRelease/2.004.schema.json"
	DESC "base kW of the world objects whose value in release 2.004 differs from the energy levels"
		+ "table; applies to 2.004 and every earlier release"
		REF @DATATABLE.EnergyLevels

DATATABLE OxygenTankCapacities
	TABLE "packages/data-world-objects/oxygenTankCapacities.json"
	KEY worldObjectName
	JSON_SCHEMA "packages/data-world-objects/oxygenTankCapacities.schema.json"
	DESC "the oxygen capacity of a player wearing each oxygen tank tier"
