SECTION GlobalMetadata
	HOLDS_FOR all
	LABEL "Global metadata"
	INDEX 0
	LEGACY_INDEX 0
	ATTESTED_BY "packages/shared-save-processing/sectionIndexes.js::GLOBAL_METADATA_SECTION_INDEX ="
		+ "0"
	ATTESTED_BY "packages/shared-save-processing/schemas/save-file.schema.json::Section 0 — Player"
		+ "progression"
	ATTESTED_BY "packages/shared-save-processing/normalizeRawSections.js::rawParts.slice(0,"
		+ "LEGACY_TERRAIN_LAYERS_SECTION_INDEX)"
	SOURCE "Extracted from docs/save-format.md and from the section index module on 2026-09-18"

