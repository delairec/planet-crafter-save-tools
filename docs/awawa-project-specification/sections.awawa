SECTION Reserved
	HOLDS_FOR all
	LABEL "Reserved"
	INDEX 10
	LEGACY_INDEX 11
	DESC "the empty trailing part the terminating separator produces; the game writes no entry in"
		+ "it"
	ATTESTED_BY "packages/shared-save-processing/sectionIndexes.js::RESERVED_TRAILING_SECTION_INDEX"
		+ "= SAVE_SECTIONS_COUNT"
	ATTESTED_BY "packages/shared-save-processing/sectionIndexes.js::const"
		+ "LEGACY_SAVE_SECTIONS_COUNT = 11"
	ATTESTED_BY "packages/shared-save-processing/schemas/save-file.schema.json::Section 10 —"
		+ "Reserved"
	SOURCE "Extracted from docs/save-format.md and from the section index module on 2026-09-18"

SECTION TerrainLayers
	HOLDS_FOR @GAME_RELEASE.1.618
	LABEL "Terrain layers"
	INDEX 9
	LEGACY_INDEX 9
	DESC "the section a game update removed; a legacy save still carries it and loading one"
		+ "discards it with a warning"
	ATTESTED_BY "packages/shared-save-processing/sectionIndexes.js::LEGACY_TERRAIN_LAYERS_SECTION_INDEX"
		+ "= 9"
	ATTESTED_BY "packages/ui-save-manager/e2e/fixtures/legacy-format_valid.json::PC-Toxicity-Layer2"
	SOURCE "Extracted from docs/save-format.md and from the section index module on 2026-09-18"
