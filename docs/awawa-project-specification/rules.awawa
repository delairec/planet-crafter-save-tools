	APPLIES_TO_SECTION @SECTION.WorldEvents
	VALUES_FROM @DATATABLE.PlanetNamesByNumericId
	RATIONALE "The id is the stable hash of the planet name, a two-accumulator djb2 over its UTF-16"
		+ "code units, which reproduces the six known ids; the table stays a maintained lookup"
		+ "because a save carries the id and the name must be found from it"
	SOURCE "Extracted from docs/save-format.md, Planet numeric IDs, on 2026-09-18"
	SOURCE "Hash algorithm and the six ids it reproduces, Skeo -440810600 among them, read on"
		+ "2026-09-21 and recomputed for the six names"
		REF @URL.PceditPlanetHash
