RULE APlayerEntryMayOmitTheFieldsAddedByALaterUpdate
	HOLDS_FOR @GAME_RELEASE.1.618
	HOLDS_FOR @GAME_RELEASE.2.004
	DOMAIN format
	SPEC "a player entry may omit cameraView, totalCraftedObjects and totalTerraTokenEarned, which"
		+ "the section schema does not require"
		ATTESTED_BY "packages/shared-save-processing/schemas/section2-players.schema.json::\"required\":"
			+ "[\"id\", \"name\""
		ATTESTED_BY "packages/core-mapping/src/domain/rules/merge/mergePlayers.ts::LegacyCompatiblePlayer"
	APPLIES_TO_SECTION @SECTION.Players
	SOURCE "Extracted from docs/game-rules.md on 2026-09-18: the first sentence of GR-PLAYER-4, a"
		+ "fact about the save left inside @RULE.PlayersAreDeduplicatedByName"
		REF @RULE.PlayersAreDeduplicatedByName

