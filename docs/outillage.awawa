// L'outillage, la chaine de build et la CI.
DECISION LesCommandesNodeExecutentLesSourcesParDesHooks
	DESC "les commandes Node executent les sources du depot par les hooks de personnalisation de"
		+ "modules de Node : un hook de resolution essaie les deux extensions, un hook de"
		+ "chargement confie les modules TypeScript a un transformateur"
	DESC "aucune regle de source, aucune build, aucun Bun a l'execution ; les tests, le type-check,"
		+ "la build de l'UI et les commandes Bun ne voient jamais les hooks"
	STATUS implemented
	RATIONALE "les alternatives demandaient soit de faire dependre de Bun une commande de"
		+ "compatibilite Node, soit de commiter un bundle, soit de tenir a la main des regles de"
		+ "source — 112 fichiers non conformes, enfreintes le jour de leur enregistrement, et 344"
		+ "imports pour la variante par option du compilateur"
	REJECTED "empaqueter les sources avec l'outillage Bun"
	REJECTED "commiter un bundle"
	REJECTED "tenir a la main des regles de source dans tout le depot"
	SPEC "les hooks sont installes par un module d'enregistrement, et rien d'autre ne les charge"
		IMPL "scripts/node/register.js"
		IMPL "scripts/node/hooks.js"
	SOURCE "decision du 2026-09-07, PR #34"

DECISION NpmEstSupportePourLesUtilisateursPasPourLeProjet
	DESC "le workspace declare des plages de versions explicites plutot que des references de"
		+ "catalogue, pour qu'une installation npm passe chez un utilisateur ; une version partagee"
		+ "passe par une surcharge a la racine"
	DESC "le lockfile de Bun est le seul lockfile du projet ; celui de npm est ignore par git et"
		+ "jamais maintenu"
	STATUS implemented
	RATIONALE "npm rejette les protocoles de catalogue et de workspace, et l'outil de mise a jour"
		+ "de dependances ne resout pas non plus un catalogue : une dependance declaree par"
		+ "catalogue n'est jamais montee, sans pull request ni avertissement"
	REJECTED "garder les references de catalogue et renoncer au support npm"
	REJECTED "maintenir un second lockfile"
	SPEC "le manifeste racine declare les versions explicitement"
		IMPL "package.json"
	SOURCE "decision du 2026-09-07, PR #34 ; angle mort des catalogues constate le 2026-09-10"

DECISION LeTypeCheckEstParPackageSansOrchestrateur
	DESC "un fichier de configuration TypeScript et un script de type-check par package, enchaines"
		+ "par le filtre de workspace : aucun orchestrateur de monorepo"
	DESC "seuls les packages d'UI declarent les bibliotheques du navigateur ; une globale"
		+ "navigateur referencee depuis un package core ou cli echoue au lieu de se resoudre en"
		+ "silence"
	DESC "aucun script de la racine ne nomme un chemin interne a un package : un package qui porte"
		+ "deux programmes les enchaine lui-meme"
	STATUS implemented
	RATIONALE "la reserve posee a la planification — ne pas introduire d'orchestrateur de monorepo"
		+ "sans en rediscuter — n'a jamais eu a etre engagee : un fichier de configuration et un"
		+ "script par package suffisent"
	RATIONALE "les deux programmes d'un meme package portaient la meme cle de script et la fusion"
		+ "des manifestes en avait garde une seule, en silence"
	REJECTED "un orchestrateur de monorepo"
	REJECTED "un script de la racine nommant un chemin interne a un package"
	SPEC "chaque package porte son programme de type-check et la racine les enchaine"
		IMPL "package.json::lint:types"
	SOURCE "decision du 2026-09-04, T17 ; livree par la PR #44"

DECISION LaPorteQualiteEstPartageeEnDeuxJobsDeCi
	DESC "la CI couvre le terrain de l'audit qualite en deux jobs : l'un lance les gardes, l'autre"
		+ "l'audit et le rapport de sante de l'outil d'analyse, tous deux rendus dans le resume du"
		+ "run"
	DESC "la commande d'audit complete reste celle d'une copie de travail et n'est pas rebranchee"
		+ "telle quelle dans un job"
	STATUS implemented
	RATIONALE "la CI n'a pas a lancer la meme commande que le poste de travail, elle a a couvrir le"
		+ "meme terrain ; deux conclusions anterieures du meme jour, qui ecartaient l'outil"
		+ "d'analyse de la CI puis supprimaient son job, ont ete annulees"
	RATIONALE "les scripts d'audit cadrent sur un nom de branche nu, qu'un checkout de CI ne resout"
		+ "pas : mesure, le cadrage par nom nu sort en erreur la ou le cadrage par reference de"
		+ "suivi passe. L'action, elle, cadre sur la base de la pull request, plus juste sur une"
		+ "pile de branches"
	REJECTED "rebrancher la commande d'audit complete dans un job"
	REJECTED "ecarter l'outil d'analyse de la CI"
	REJECTED "basculer les scripts sur une reference de suivi et supprimer le job d'analyse, ce qui"
		+ "reglait le symptome au prix du resume"
	SPEC "les deux jobs couvrent les gardes et l'audit sans rien executer deux fois"
		IMPL ".github/workflows/quality.yml"
	SOURCE "decision du 2026-09-09, T22, PR #45, second tour"

DECISION NodeSuitSesVersionsBunResteEpingle
	DESC "les deux chaines d'outils sont lues depuis le manifeste : la version de Node y est une"
		+ "plage ouverte, celle de Bun est epinglee"
	STATUS implemented
	RATIONALE "Node est le runtime cible des commandes de compatibilite : les suivre est de la"
		+ "couverture, et une release qui casse les hooks doit se voir. Bun est l'outillage de"
		+ "build et de test, suivre ses releases ne teste rien que le produit promette"
	RATIONALE "cout mesure en prime : demander la derniere version de Bun desactive le cache de"
		+ "l'action d'installation, soit un telechargement a chaque job de chaque run"
	REJECTED "epingler Node comme Bun"
	REJECTED "suivre les releases de Bun"
	REJECTED "repeter les versions dans les workflows au lieu de les lire depuis le manifeste"
	SPEC "les workflows lisent les deux versions depuis le manifeste"
		IMPL "package.json"
	SOURCE "decision du 2026-09-09, revue de T22, PR #45"

DECISION LesTachesDOutillagePortentLaFamilleDep
	DESC "les taches d'outillage du depot sont numerotees dans une famille propre, a cote de la"
		+ "serie du chantier de conformite, et ne participent d'aucune vague"
	DESC "convention propre a ce projet : le gabarit general de fiche ne connait que la serie"
		+ "ordinaire"
	STATUS specified
	RATIONALE "elles ne partagent aucun fichier avec le chantier et ne dependent d'aucune de ses"
		+ "taches"
	REJECTED "les numeroter dans la serie du chantier"
	REJECTED "generaliser la convention aux instructions generales"
	SOURCE "decision du 2026-09-10, ouverture de DEP1"

DECISION DependabotSuitDeuxEcosystemesEnGroupesHebdomadaires
	DESC "deux ecosystemes suivis, les actions de CI et les dependances du workspace, un groupe par"
		+ "ecosysteme, hebdomadaire, avec une limite de pull requests relevee explicitement"
	DESC "l'ecosysteme du gestionnaire de paquets ne fait que des mises a jour de version : l'audit"
		+ "de vulnerabilites reste le filet de securite"
	DESC "les pull requests ouvertes par le robot sont exclues de la revue automatique : elles"
		+ "recoivent un jeton en lecture seule et aucun secret, donc le job echouerait a chaque"
		+ "fois"
	STATUS implemented
	RATIONALE "la valeur par defaut de la limite est cinq : une file tronquee en silence est"
		+ "refusee"
	RATIONALE "la separation production / developpement dans un groupe n'est pas honoree par cet"
		+ "ecosysteme ; le fichier porte le commentaire qui le dit, pour qu'un relecteur ne"
		+ "retablisse pas une separation inerte"
	RATIONALE "verifie sur la premiere execution reelle : deux pull requests ouvertes dans les"
		+ "trois minutes, les deux defauts amont redoutes ne se reproduisent pas, et la garde"
		+ "d'acteur fonctionne"
	REJECTED "laisser la limite de pull requests a sa valeur par defaut"
	REJECTED "separer production et developpement dans le groupe du gestionnaire de paquets"
	REJECTED "garder la revue automatique sur les pull requests du robot"
	SPEC "la configuration declare les deux ecosystemes depuis la racine"
		IMPL ".github/dependabot.yml"
	SOURCE "decision du 2026-09-10, DEP1, PR #53 ; verifiee sur execution reelle"
