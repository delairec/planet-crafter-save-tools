// Les arbitrages qui tiennent sur la conduite du travail : ou vit le corpus, comment on revient
// sur ce qu'il enregistre, la pile de branches, le contexte prive. Ils vivaient dans l'AGENTS.md
// prive, qui les enonce sans les indexer.
DECISION LeCorpusVitDansLeDepotPublic
	DESC "le corpus est un ensemble de fichiers dans docs/, la racine de workspace restant la"
		+ "racine du depot public"
	DESC "toujours lancer awawa depuis un worktree du depot public, avec . pour racine"
	DESC "lire une decision ne demande plus de synchroniser le depot prive"
	STATUS implemented
	RATIONALE "le montage par lien tenait le corpus hors du depot public et coutait trois choses :"
		+ "une regle gitignore a maintenir, un clone fige par worktree dont une decision citee"
		+ "pouvait etre fausse sans aucun signe, et un arbitrage separe du code qu'il gouverne,"
		+ "donc invisible en revue"
	RATIONALE "le corpus dans la branche fait entrer la decision dans la pull request qui"
		+ "l'implemente et la fait suivre les rebases de la pile"
	REJECTED "attendre la confirmation de l'experimentation awawa : le repli tient a un tag, pas a"
		+ "l'emplacement du corpus"
	REJECTED "decouper le corpus en plusieurs fichiers dans le meme mouvement : le deplacement se"
		+ "verifie seul, et le decoupage se refera contre un corpus qui aura bouge"
		REF @DECISION.LeCorpusEstDecoupeParDomaine
	SPEC "le corpus est versionne dans le depot public et ne porte ni nom reel de joueur ni"
		+ "identifiant de compte reel"
		IMPL "docs"
	SOURCE "decision du 2026-09-12"

DECISION LeCorpusEstDecoupeParDomaine
	DESC "le corpus est un fichier .awawa par domaine dans docs/, plus _schema.awawa pour le schema"
		+ "transverse et les champs communs"
	DESC "chaque domaine porte son SCHEMA a cote de ses donnees ; les questions ouvertes et les"
		+ "limitations acceptees sont groupees, pas reparties par domaine"
	STATUS implemented
	RATIONALE "spec.awawa etait touche par presque toutes les branches de taches et concentrait les"
		+ "conflits de rebase de la pile ; un fichier par domaine les separe"
	RATIONALE "c'est la forme que le manuel decrit pour un corpus qui grandit par domaine : un"
		+ "fichier racine portant le schema transverse, un fichier par domaine portant ses types a"
		+ "cote de ses donnees. Rien ne change pour l'outil, qui charge toute la marche"
	RATIONALE "regrouper les questions ouvertes et les limitations garde lisible au fil du texte ce"
		+ "que status OPEN_QUESTION donne deja par requete : le tri des points non tranches se"
		+ "relit d'une traite, sans parcourir onze fichiers"
	REJECTED "un repertoire .awawa : la marche du workspace saute les fichiers et les repertoires"
		+ "prefixes d'un point, et le corpus y deviendrait invisible sans aucun diagnostic"
	REJECTED "un repertoire dedie a la racine ou docs/spec : docs/ existe deja, n'est publie par"
		+ "aucun workflow, et porte deja la documentation que plusieurs decisions ancrent"
	REJECTED "garder un seul fichier jusqu'a la taille cible de 5 000 lignes : le cout n'est pas la"
		+ "lecture, qui passe par l'outil, mais le conflit de rebase, deja la"
	SPEC "chaque fichier du corpus est dans docs/ et le schema transverse est dans _schema.awawa"
		IMPL "docs/_schema.awawa::SCHEMA *"
	SOURCE "decision du 2026-09-12"

DECISION LExperimentationAwawaEstReversibleParUnTagPasParUneBranche
	DESC "l'etat d'avant awawa est marque par un tag dans chacun des trois depots :"
		+ "pcst/before-awawa dans .do-not-commit, before-awawa dans ~/.ai, before-awawa sur la base"
		+ "des taches du depot public — le parent de la fusion de DEP2"
	DESC "aucune branche experimentale : les trois depots gardent leur cycle ordinaire, le clone"
		+ "prive sur planet-crafter-save-tools, les instructions par PR sur main, le public sur sa"
		+ "base de taches"
	STATUS specified
	RATIONALE "private:sync repositionne le clone prive sur la branche nommee d'apres le projet :"
		+ "une branche experimentale y est defaite en silence, un tag ne depend d'aucune branche"
		+ "courante"
	RATIONALE "le repli ne demande pas une branche vivante, seulement un point de retour nomme"
	REJECTED "garder pcst/awawa et apprendre a install.sh une branche surchargeable : de"
		+ "l'outillage ajoute pour un chantier temporaire"
	REJECTED "nommer le tag before-awawa dans .do-not-commit, qui porte plusieurs projets : le"
		+ "prefixe pcst/ le desambigue"
	SOURCE "decision du 2026-09-11, session d'installation d'awawa"

DECISION UneLimitationAccepteeGardeSaMatiereDansLaDecision
	DESC "une limitation acceptee se modelise en question superseded plus decision qui la ferme, et"
		+ "c'est la decision qui porte symptome, cause et garde"
	STATUS implemented
	RATIONALE "superseded vaut GATE suppressed : la question disparait des paquets de recuperation."
		+ "Or une fiche de limitation acceptee existe precisement pour rester lisible — mettre sa"
		+ "matiere dans la question la ferait disparaitre le jour ou elle est fermee"
	REJECTED "laisser la question ouverte pour qu'elle reste visible : elle est tranchee, et"
		+ "l'ouverture mentirait sur l'etat du projet"
	SPEC "chaque fiche de known-issues fermee a sa decision porteuse dans ce corpus"
		IMPL "docs/limitations.awawa"
	SOURCE "decision du 2026-09-11, migration de known-issues"

DECISION LaBaseDesTachesEstTemporairementLaBrancheDeConformite
	DESC "toute branche de tache part de"
		+ "refactor/review-clean-archi-violations-in-core-mapping-package et sa PR la prend pour"
		+ "base, jamais master"
	DESC "base temporaire : une fois le chantier de conformite fusionne, master redevient la base"
		+ "et cette entite est le seul endroit a corriger"
	STATUS specified
	RATIONALE "master est en retard sur la branche de conformite ; une tache basee sur master"
		+ "rebaserait tout le chantier"
	REJECTED "baser les taches sur master tant que le chantier n'est pas fusionne"
	SOURCE "AGENTS.md prive, section Branches"

DECISION TroisFichiersPartentDeMasterEtNonDeLaBase
	DESC "dependabot.yml et les deux workflows claude se modifient d'abord sur master, la base les"
		+ "recoit au rebase suivant"
	STATUS implemented
	RATIONALE "dependabot.yml n'est lu que sur la branche par defaut ; les deux workflows sont"
		+ "valides par claude-code-action contre leur copie sur cette meme branche, et un contenu"
		+ "qui differe fait sortir l'action en avertissement — job vert, revue silencieusement"
		+ "morte"
	REJECTED "traiter ces trois fichiers comme le reste du depot, depuis la base des taches"
	SPEC "les trois fichiers existent et ne se modifient que depuis master"
		IMPL ".github/dependabot.yml"
		IMPL ".github/workflows/claude.yml"
		IMPL ".github/workflows/claude-code-review.yml"
	SOURCE "decision du 2026-09-10"

DECISION UneBrancheDeTacheEstRebaseeJamaisFusionnee
	DESC "le depot est une pile git machete ; un commit de fusion a l'interieur de la pile est"
		+ "defait au premier traverse"
	DESC "avant de travailler sur une branche deja poussee, et surtout avant de traiter une revue :"
		+ "verifier que la base est ancetre de HEAD, sinon rebaser et pousser avec"
		+ "force-with-lease, avant de lire le premier commentaire"
	STATUS specified
	RATIONALE "la base bouge pendant l'attente d'une revue ; lire les commentaires sur une branche"
		+ "en retard fait travailler sur un etat qui n'existe plus"
	REJECTED "fusionner la base dans la branche de tache"
	SOURCE "AGENTS.md prive, section Branches"

DECISION LaSpecificationResteEnFrancaisMemePubliee
	DESC "le corpus et AGENTS.md restent en francais bien qu'ils soient publics"
	DESC "le reste du depot public reste en anglais : README, docs, commentaires de code, messages"
		+ "de commit"
	DESC "le depot prive reste integralement en francais"
	STATUS implemented
	RATIONALE "la regle generale, documentation publique commitee en anglais, vise ce qu'un lecteur"
		+ "du depot lit ; ces deux fichiers sont des instructions d'agent, relues a chaque session"
		+ "par un seul lecteur humain qui travaille en francais"
	RATIONALE "l'exception est ici et nulle part ailleurs : elle est a reporter dans les"
		+ "instructions generales si elle doit valoir pour d'autres projets"
	REJECTED "traduire le corpus en anglais au moment de le publier : deux mille trois cents lignes"
		+ "a traduire, et une traduction fige mal un texte reecrit a chaque session"
	REJECTED "aligner AGENTS.md sur la regle anglaise et laisser le corpus en francais : les deux"
		+ "fichiers se lisent ensemble"
	SPEC "le corpus et AGENTS.md du depot public sont rediges en francais"
		IMPL "docs"
		IMPL "AGENTS.md"
	SOURCE "decision du 2026-09-12"

DECISION AucunNomReelDansUnContenuPublic
	DESC "aucun nom reel de joueur n'apparait dans un contenu public : corps et titre de PR,"
		+ "commentaires de revue, code, tests, fixtures publiques, docs, README, messages de commit"
	DESC "seuls ces pseudonymes sont autorises en public : Salengor, Chileny, Sovagoz, Nikowa,"
		+ "Sakia, Anya"
	DESC "le depot prive reste la source de verite et conserve les noms reels ; c'est au moment de"
		+ "sortir en public qu'il faut substituer"
	DESC "aucune correspondance entre un pseudonyme et un nom reel n'est conservee nulle part :"
		+ "elle ne servirait qu'a defaire l'anonymisation"
	STATUS specified
	RATIONALE "les saves privees portent les noms reels des joueurs, qui n'ont pas consenti a leur"
		+ "publication"
	REJECTED "reecrire l'historique git deja pousse : cout hors de proportion, et la branche de"
		+ "conformite sera vraisemblablement ecrasee a sa fusion"
	SOURCE "decision du 2026-09-10, PR #49"

DECISION LesIdentifiantsSteamSontAnonymisesCommeLesNoms
	DESC "un contenu public porte un identifiant synthetique de la famille 765611900000000xx,"
		+ "jamais celui d'un compte reel"
	DESC "le discriminant suffit et remplace toute correspondance : 76561198… est un identifiant"
		+ "reel, 765611900000000xx un identifiant synthetique"
	DESC "un identifiant de demonstration doit rester un couple d'arrondi vrai — texte exact non"
		+ "representable en double, valeur imprimee differente — sinon la demonstration devient"
		+ "fausse"
	STATUS specified
	RATIONALE "un identifiant de compte designe une personne aussi surement qu'un nom"
	REJECTED "publier les identifiants reels au motif qu'ils ne portent pas de nom"
	REJECTED "prendre un identifiant synthetique quelconque : il ne demontrerait plus l'arrondi"
	SOURCE "decision du 2026-09-10"

DECISION ChaqueWorktreeInstalleSesDependances
	DESC "bun install --frozen-lockfile dans le worktree, avant le premier test"
	STATUS specified
	RATIONALE "sans lui, Bun resout les packages du workspace via le node_modules du depot"
		+ "principal : les tests s'executent sur les sources d'une autre branche et passent au vert"
		+ "sans rien dire. C'est le piege le plus couteux, parce qu'il rend un verdict, et le"
		+ "mauvais"
	RATIONALE "deux autres gestes vont avec : verifier que la branche part bien de la base en"
		+ "vigueur, et lier input/ depuis le depot principal — ce repertoire n'est pas versionne et"
		+ "la regle input/ du .gitignore ne vise qu'un repertoire, un lien y echappe et se fait"
		+ "indexer par un ajout global"
	REJECTED "se fier au node_modules du depot principal"
	SOURCE "AGENTS.md prive, section Travail dans un arbre de travail lie"

DECISION UnWorktreeEstDecoupeDansLeDepotDuRepertoireCourant
	DESC "ne jamais entrer dans le clone prive : le lire la ou il est, par -C pour git et en"
		+ "chemins absolus pour le reste"
	DESC "avant de lancer un agent, la racine du depot vue depuis le repertoire courant doit etre"
		+ "celle du depot public"
	STATUS specified
	RATIONALE "le clone prive est un depot a part entiere imbrique dans le depot public, et un"
		+ "worktree est decoupe dans le depot qui contient le repertoire de travail du shell au"
		+ "moment de l'appel. Une session qui y entre donne a chaque agent qu'elle lance un"
		+ "worktree du depot prive : la garde d'isolation refuse alors tout git visant le depot"
		+ "public, l'agent se rabat sur un clone a lui, le travail aboutit hors de l'isolation"
		+ "prevue, et le nettoyage des worktrees ne voit pas ce clone"
	REJECTED "entrer dans le clone prive pour y lire une fiche"
	SOURCE "constate le 2026-09-10, vague T39/T30"

DECISION LeContextePriveSeReduitAuxSavesEtAuxPlans
	DESC "le depot prive ne porte plus que les saves de reference, les plans et resources.md : ni"
		+ "instructions, ni specification, ni AGENTS.md"
	DESC "le rafraichir avant de lire une save ou un plan ; plus avant de citer une decision ou de"
		+ "choisir un numero de tache"
	STATUS implemented
	RATIONALE "la specification, les decisions et les numeros de tache sont dans le depot public :"
		+ "ce qu'un clone perime rendait faux sans signe ne s'y lit plus"
	REJECTED "supprimer le depot prive : les saves portent les noms reels des joueurs et pesent"
		+ "huit megaoctets"
	REJECTED "garder la synchronisation en tete de session : elle ne conditionne plus rien de ce"
		+ "qu'une session lit pour demarrer"
	SPEC "la synchronisation est un script du depot, appele par l'installation des dependances et"
		+ "relancable seul"
		IMPL "scripts/sync-private-context.sh"
		IMPL "package.json::private:sync"
	SOURCE "decision du 2026-09-12"

DECISION UneFixturePeutReposerSurUnDefautOuvert
	DESC "une fixture peut reposer sur un defaut ouvert, a condition que la question ouverte du"
		+ "defaut nomme la spec a reformuler quand il sera corrige"
	DESC "le couplage se documente du cote du defaut, pas du cote du test"
	STATUS specified
	RATIONALE "certains comportements n'ont pas de producteur naturel — verifier qu'une sortie"
		+ "invalide est bien signalee demande une entree qui en produit une — et le seul"
		+ "arrangement honnete est alors un defaut reel plutot qu'une entree fabriquee qui ne se"
		+ "rencontre jamais"
	RATIONALE "c'est la question qui est lue au moment de corriger, et elle porte la preuve que la"
		+ "spec echoue une fois le defaut parti, plus ce qu'il faudra faire : trouver un autre"
		+ "producteur, pas seulement remettre l'assertion au vert"
	REJECTED "fabriquer une entree qui ne se rencontre jamais pour eviter de dependre d'un defaut"
	REJECTED "documenter le couplage du cote du test"
	SOURCE "AGENTS.md prive ; exemple en vigueur T28, PR #59"

DECISION LeCorpusRemplaceLaChecklistDeFusion
	DESC "une PR de tache ne porte plus de commentaire « A faire a la fusion » : ce que la"
		+ "checklist inventoriait entre dans le corpus au moment ou la decision est prise, pas a la"
		+ "fusion"
	DESC "reste attache a la fusion la promotion de STATUS — une TASK passe implemented une fois sa"
		+ "PR fusionnee — et ce qui vit hors du corpus : une regle a promouvoir vers ~/.ai, le"
		+ "nettoyage du worktree et de la branche"
	DESC "deux commandes sur les deux moments reels : /awawa-pr-review avant la fusion,"
		+ "/awawa-pr-merged apres"
	DESC "le residu que le corpus ne porte pas — une regle a promouvoir vers ~/.ai — s'ecrit en"
		+ "OPEN_QUESTION a la revue : general ou specifique au projet est l'arbitrage de"
		+ "l'utilisateur, et rien hors du corpus ne survit a la session qui l'a appris"
	STATUS superseded
	RATIONALE "le motif de la checklist etait qu'un inventaire disparait avec la session de l'agent"
		+ "de tache ; le corpus est cet inventaire et il ne disparait pas"
	RATIONALE "la moitie post-fusion ne peut pas tourner avant le git merge de l'utilisateur et"
		+ "demande un worktree autre que celui de la premiere : une commande unique ne couvre pas"
		+ "les deux moments"
	REJECTED "une seule commande /awawa-pr-review couvrant les deux moments"
	REJECTED "garder la checklist en la vidant de ce que le corpus porte : un commentaire reduit a"
		+ "la promotion de STATUS ne vaut pas la discipline qu'il coute"
	REJECTED "garder un commentaire de PR pour le seul residu ~/.ai : une entite le porte mieux,"
		+ "elle est typee, interrogeable, et visible a chaque status jusqu'a sa fermeture"
	REJECTED "corriger /pr-merge-followup et /pr-review-followup en place : elles servent les"
		+ "projets sans corpus et gardent leur forme"
	SOURCE "decision du 2026-09-11, session d'installation d'awawa"

DECISION LeCorpusRemplaceLaChecklistDeFusion:v2
	DESC "une PR de tache ne porte plus de commentaire « A faire a la fusion » : ce que la"
		+ "checklist inventoriait entre dans le corpus au moment ou la decision est prise, pas a la"
		+ "fusion"
	DESC "la promotion se fait dans la pull request de tache elle-meme : la tache passe"
		+ "implemented, les decisions qu'elle livre passent implemented, les questions qu'elle"
		+ "tranche passent superseded par le CLOSES d'une decision — tout avant l'ouverture de la"
		+ "PR, et la revue verifie ces promotions comme elle verifie le code, chaque SPEC promue"
		+ "ayant son IMPL resolu dans le diff (L016)"
	DESC "un STATUS implemented ecrit dans la branche a la semantique du code que la PR livre :"
		+ "vrai dans l'arbre de la branche, vrai dans la base quand la fusion le porte, jamais vrai"
		+ "si la PR meurt"
		REF @DECISION.LeCorpusVitDansLeDepotPublic
	DESC "il n'y a pas de promotion apres la fusion et /awawa-pr-merged est retiree ; l'arbitrage"
		+ "general ou specifique au projet d'une regle d'instruction se pose a la revue, par"
		+ "/awawa-pr-review, avant que la PR soit signalee prete"
	DESC "le rapport d'usage se commite sur la branche de tache, par /awawa-usage-report <N> une"
		+ "fois la revue traitee ; apres la fusion, rien ne tourne, les worktrees se nettoient par"
		+ "/worktree-clean"
		REF @DECISION.UnRapportDUsageEstCommiteDansLaPrDeTacheParUneSessionIndependante
	DESC "garde : la revue verifie chaque promotion contre le diff et refuse celle dont l'ancre ne"
		+ "resout pas ou dont le diff ne livre pas le SPEC"
	STATUS specified
	SUPERSEDES @DECISION.LeCorpusRemplaceLaChecklistDeFusion
	RATIONALE "ce qui change : le moment de la promotion. La regle « implemented n'est vrai que de"
		+ "la base » date du corpus vivant dans le clone prive, ou une promotion sur une branche ne"
		+ "voyageait pas avec la PR ; depuis que le corpus est dans la branche, elle voyage"
	RATIONALE "chaque /awawa-pr-merged a ouvert une PR de plus : 65 a ouvert la PR #66, 68 la PR"
		+ "#69, et un passage sur la PR #69 aurait ouvert une PR #70 sans rien a promouvoir"
	RATIONALE "le motif de la checklist etait qu'un inventaire disparait avec la session de l'agent"
		+ "de tache ; le corpus est cet inventaire et il ne disparait pas"
	RATIONALE "la successeure garde le nom et prend :v2 parce que sa lecture change"
		REF @DECISION.UneDecisionRetireeNommeSaSuccesseure
	REJECTED "promouvoir apres la fusion dans une PR de suite : une PR de plus a chaque tour, sans"
		+ "rien a promouvoir des la seconde"
	REJECTED "une seule commande /awawa-pr-review couvrant les deux moments"
	REJECTED "garder la checklist en la vidant de ce que le corpus porte : un commentaire reduit a"
		+ "la promotion de STATUS ne vaut pas la discipline qu'il coute"
	REJECTED "garder un commentaire de PR pour le seul residu ~/.ai : une entite le porte mieux,"
		+ "elle est typee, interrogeable, et visible a chaque status jusqu'a sa fermeture"
	REJECTED "corriger /pr-merge-followup et /pr-review-followup en place : elles servent les"
		+ "projets sans corpus et gardent leur forme"
	SOURCE "decision du 2026-09-11, session d'installation d'awawa"
	SOURCE "arbitrage utilisateur du 2026-09-13 sur la PR #69, livre par la PR #70"

DECISION LeCorpsDeLaPrSeMetAJourPendantLaRevue
	DESC "une revue qui change une signature, un nom public ou une phrase d'interface met a jour le"
		+ "corps de la PR, pas seulement le code et les fiches"
	STATUS superseded
	RATIONALE "dans une pile git machete, le corps d'une PR est ce que lit la tache empilee pour"
		+ "savoir ce qu'elle rebase, et ce que lit le relecteur suivant pour savoir ce qu'il relit."
		+ "Un corps qui decrit encore la signature d'avant la revue envoie la tache suivante"
		+ "travailler sur un contrat qui n'existe plus, sans qu'aucun outil ne le signale"
	REJECTED "traiter le corps de la PR comme un resume d'ouverture fige"
	SOURCE "constate le 2026-09-11, PR #59"

DECISION LeCorpsDeLaPrDecritLaTeteDeBranche
	DESC "le corps d'une PR decrit la tete de branche, pas l'intention d'ouverture : tout commit"
		+ "qui change la conception l'invalide, qu'une revue soit passee ou non"
	DESC "avant de demander une revue et avant de declarer la PR prete, relire le corps contre le"
		+ "journal des commits depuis la base, et le reecrire si un commit a change la conception"
	STATUS specified
	SUPERSEDES @DECISION.LeCorpsDeLaPrSeMetAJourPendantLaRevue
	RATIONALE "dans une pile de branches, le corps d'une PR est ce que lit la tache empilee pour"
		+ "savoir ce qu'elle rebase, et ce que lit le relecteur suivant pour savoir ce qu'il relit"
		+ "; aucun outil ne signale qu'il decrit une conception abandonnee"
	RATIONALE "mesure sur la PR #61 : le corps decrivait encore spec.awawa comme un lien vers le"
		+ "depot prive alors que trois commits plus loin le corpus etait versionne en clair dans"
		+ "docs/, et la revue a depense l'essentiel de son passage sur cet ecart au lieu du"
		+ "contenu. Le declencheur d'origine — une revue qui change une signature — ne couvrait pas"
		+ "ce cas, ou l'ecart nait des commits de la branche avant toute revue"
	REJECTED "traiter le corps de la PR comme un resume d'ouverture fige"
	REJECTED "garder le declencheur limite a la revue : l'ecart le plus couteux mesure ici est ne"
		+ "avant elle"
	REJECTED "confier le constat au relecteur : la revue de la PR #61 l'a fait, et au prix d'un"
		+ "passage entier"
	SOURCE "constate le 2026-09-12, revue de DEP2, PR #61"

DECISION LaRegleDuCorpsDePrEstGeneraleEtVaDansCommandsMd
	DESC "la regle qui veut qu'un corps de PR decrive la tete de branche est generale et vit"
		+ "desormais dans ~/.ai/instructions/commands.md"
		REF @DECISION.LeCorpsDeLaPrDecritLaTeteDeBranche
	DESC "elle s'y designe par son titre de section, « Git: the body of a pull request describes"
		+ "the branch head », et par rien d'autre : commands.md ne porte aucun identifiant de regle"
		+ "par construction, etant une procedure operationnelle jamais citee en revue"
	DESC "ce qui reste propre au projet — quelle branche est la base en vigueur — ne voyage pas"
		+ "avec la regle et garde son entite ici"
	STATUS specified
	CLOSES @OPEN_QUESTION.LaRegleDuCorpsDePrVautElleAuDelaDeCeDepot
	RATIONALE "la regle n'enonce aucun fait propre a ce projet : elle repose sur la propriete de"
		+ "pile de branches que commands.md suppose deja dans ses deux autres sections de git, et"
		+ "le cout qu'elle evite est generique — un corps perime envoie la tache empilee rebaser"
		+ "contre une conception qui n'existe plus, et rien ne le signale"
	REJECTED "la garder specifique au projet : rien dans son enonce ne nomme ce depot"
	REJECTED "lui attribuer un identifiant de regle : commands.md est hors du schema"
		+ "d'identifiants, et en inventer un rendrait citable une reference qu'aucune revue ne"
		+ "pourrait resoudre"
	SOURCE "arbitrage de l'utilisateur du 2026-09-12, fusion de DEP2, PR #61 ; promue par"
		+ "delairec/.ai#14"

DECISION UneDecisionRetireeNommeSaSuccesseure
	DESC "SCHEMA * exige une arete entrante CLOSED_BY ou SUPERSEDED_BY sur toute entite superseded"
		+ ": une decision retiree qui ne nomme pas ce qui la remplace tombe en L026"
	DESC "rouvrir une limitation acceptee se fait donc en trois gestes : la decision passe"
		+ "superseded, une successeure :v2 la SUPERSEDES et dit ce qui a change, la question"
		+ "repasse specified"
	STATUS implemented
	RATIONALE "mesure du 2026-09-11 : remettre la question a specified en laissant la decision en"
		+ "l'etat passe lint --strict sans un mot, et le corpus porte alors une decision qui"
		+ "pretend fermer une question ouverte. awawa n'a aucune primitive pour interdire une arete"
		+ "entrante, INCOMING ne sait que l'exiger — la moitie verifiable est donc celle-ci, et la"
		+ "seconde reste une discipline"
	RATIONALE "la ligne va sur SCHEMA * et non sur un type : une ligne de type s'ajoute a celle du"
		+ "caractere joker au lieu de la remplacer, et separer les deux noms ferait reclamer a"
		+ "chaque question fermee un SUPERSEDED_BY qu'elle n'aura jamais"
	REJECTED "interdire la reouverture : une limitation acceptee l'est dans un etat du projet, pas"
		+ "pour toujours"
	REJECTED "compter sur la relecture pour reperer une decision devenue caduque"
	SPEC "toute entite superseded est atteinte par CLOSED_BY ou SUPERSEDED_BY, et une question"
		+ "fermee l'est par une DECISION"
		IMPL "docs/_schema.awawa::INCOMING CLOSED_BY|SUPERSEDED_BY"
	SOURCE "decision du 2026-09-11"

DECISION LeCorpusRemplaceLesFichesDeKnownIssues
	DESC "known-issues/ est supprime : ses sept fiches sont devenues des entites de ce corpus"
	DESC "un defaut constate s'enregistre desormais en OPEN_QUESTION, et son sort en DECISION qui"
		+ "le ferme"
	STATUS implemented
	RATIONALE "un fait a un seul domicile ; garder les fiches a cote du corpus, c'est deux versions"
		+ "du meme constat qui divergent a la premiere correction"
	RATIONALE "ce que le repertoire faisait mieux que le corpus — la fiche que l'on relit au moment"
		+ "de corriger — le corpus le fait aussi, et en plus il repond a « qu'est-ce qui bloque X »"
		+ "sans que personne tienne la liste"
	REJECTED "garder les fiches et n'indexer dans le corpus que leur titre : le corps aurait"
		+ "continue a vivre hors de portee de toute commande"
	SPEC "l'inventaire des defauts se lit par status OPEN_QUESTION, jamais par un repertoire de"
		+ "fiches"
		IMPL "docs/questions.awawa"
	SOURCE "decision du 2026-09-11"

DECISION UnOctetDeControleBrutResteUnCasMarginalSansRegle
	DESC "l'ecriture d'un caractere de controle par sa sequence d'echappement plutot qu'en octet"
		+ "brut ne devient une regle nulle part : ni dans ~/.ai, ni dans les instructions du projet"
	DESC "le cas est juge marginal : un incident, corrige dans le commit qui l'a revele"
	STATUS implemented
	CLOSES @OPEN_QUESTION.UnOctetDeControleBrutRendUneSourceBinairePourGit
	RATIONALE "une regle vaut par la frequence de ce qu'elle previent ; un octet de controle brut"
		+ "dans une classe de caracteres est arrive une fois, git l'a rendu visible par le diff"
		+ "binaire, et la relecture l'a corrige"
	REJECTED "la promouvoir en regle generale, STD-8 dans ~/.ai/instructions/standards/coding.md :"
		+ "cas marginal"
	REJECTED "la garder en regle propre au projet, dans AGENTS.md : meme raison, et rien dans"
		+ "l'incident n'est propre a ce depot"
	SPEC "nameMergedFile.ts ecrit sa classe de caracteres de controle en sequences d'echappement"
		IMPL "packages/core-mapping/src/application/nameMergedFile.ts"
	SOURCE "arbitrage de l'utilisateur du 2026-09-12, fusion de la PR #62"

DECISION UnRapportDUsageEstEcritApresChaqueFusionParUneSessionIndependante
	DESC "apres /awawa-pr-merged, /awawa-usage-report lance un agent sans memoire du travail juge,"
		+ "Claude Fable 5.1 en effort medium, qui ecrit un rapport par PR fusionnee dans"
		+ "docs/awawa-usage-reports/"
	DESC "la forme a un seul domicile, le gabarit _template.md : verdict nous / verdict outil,"
		+ "chacun en bien passe, mal passe, remediations ; points recurrents, douloureux et"
		+ "positifs, avec leur nombre d'occurrences ; mesures tirees des transcriptions en annexe"
	DESC "le rapport cite les entites, n'en recopie aucune"
		REF @DECISION.LeCorpusEstLeSeulDomicileEtHistoryEstSupprime
	STATUS superseded
	RATIONALE "le premier rapport d'usage a ete ecrit par la session fautive : aucune mesure, deux"
		+ "affirmations surestimees, relevees par une revue independante"
	REJECTED "la session pilote ecrit le rapport : elle note son propre travail"
	REJECTED "un rapport par session : seule la fusion voit le parcours complet"
	REJECTED "les mesures dans le corpus : faits sur l'instrument, pas sur le projet"
	SPEC "un fichier par PR fusionnee dans docs/awawa-usage-reports/, conforme au gabarit"
		IMPL "docs/awawa-usage-reports/_template.md"
	SPEC "le rapport nomme son auteur, le modele des sessions evaluees et les sessions mesurees"
		IMPL "docs/awawa-usage-reports/_template.md"
	SOURCE "decision du 2026-09-12, revue du premier rapport d'usage, PR #63"

DECISION UnRapportDUsageEstCommiteDansLaPrDeTacheParUneSessionIndependante
	DESC "le rapport d'usage d'une pull request qu'une entite TASK nomme dans son champ PR — tache"
		+ "ou famille DEP — est commite sur la branche de cette pull request, avant la fusion, par"
		+ "/awawa-usage-report <N> une fois la revue traitee et la PR signalee prete"
	DESC "il est ecrit par un agent independant : une session neuve, sans memoire du travail juge,"
		+ "jamais un fork, Claude Fable 5.1 en effort medium ; autre agent que celui qui a"
		+ "implemente, aucun contexte partage"
	DESC "une pull request par tache porte le code, les promotions, les arbitrages et le rapport ;"
		+ "la fusion porte le tout dans la base d'un coup, et rien ne tourne apres"
		REF @DECISION.LeCorpusRemplaceLaChecklistDeFusion:v2
	DESC "le rapport mesure l'arbitrage, l'implementation et la revue, promotions comprises puisque"
		+ "dans la PR ; il ne mesure plus de cloture, il n'y en a pas"
	DESC "le fichier garde la forme docs/awawa-usage-reports/<date>-pr-<N>.md, la date etant celle"
		+ "du rapport"
	DESC "la forme a un seul domicile, le gabarit _template.md : verdict nous / verdict outil,"
		+ "chacun en bien passe, mal passe, remediations ; points recurrents, douloureux et"
		+ "positifs, avec leur nombre d'occurrences ; mesures tirees des transcriptions en annexe"
	DESC "le rapport cite les entites, n'en recopie aucune"
		REF @DECISION.LeCorpusEstLeSeulDomicileEtHistoryEstSupprime
	STATUS specified
	SUPERSEDES @DECISION.UnRapportDUsageEstEcritApresChaqueFusionParUneSessionIndependante
	RATIONALE "ce qui change, d'ou le nouveau nom : le rapport n'est plus ecrit apres la fusion ni"
		+ "dans une PR a lui. La chaine #65 → #67 → #68 → #69 a coute une PR de plus a fusionner"
		+ "par tache, et un rapport sur les PR #66 a #69 mesurerait des sessions qui n'ont fait que"
		+ "promouvoir un statut ou ecrire des entites"
	RATIONALE "le premier rapport d'usage a ete ecrit par la session fautive : aucune mesure, deux"
		+ "affirmations surestimees, relevees par une revue independante"
	REJECTED "une PR de rapport a part : une PR de plus a fusionner par tache, la chaine #65 → #67"
		+ "→ #68 → #69"
	REJECTED "le rapport ecrit par la session qui implemente ou par celle qui relit : elle note son"
		+ "propre travail"
	REJECTED "un rapport sur chaque pull request fusionnee : la chaine ne se ferme jamais"
	REJECTED "un rapport par session : seule la PR entiere voit le parcours complet"
	REJECTED "les mesures dans le corpus : faits sur l'instrument, pas sur le projet"
	SPEC "un fichier par PR de tache dans docs/awawa-usage-reports/, conforme au gabarit, commite"
		+ "sur la branche de la PR avant sa fusion ; aucun pour une pull request de suite"
		IMPL "docs/awawa-usage-reports/_template.md"
	SPEC "le rapport nomme son auteur, le modele des sessions evaluees et les sessions mesurees"
		IMPL "docs/awawa-usage-reports/_template.md"
	SOURCE "decision du 2026-09-12, revue du premier rapport d'usage, PR #63"
	SOURCE "arbitrage utilisateur du 2026-09-13 sur la PR #69, livre par la PR #70"

DECISION UneRecommandationEstExamineeAvantLaRatificationEstUneRegleGenerale
	DESC "la regle est generale : elle vit dans la section Always de ~/.ai/AGENTS.md, a cote de la"
		+ "regle d'enregistrement des decisions, livree par delairec/.ai PR #15"
	DESC "une recommandation posee a cote d'une question ouverte n'est pas pre-approuvee : la"
		+ "session l'examine contre le code et les decisions enregistrees avant d'en proposer la"
		+ "ratification, et la ratification en bloc n'est jamais la premiere option"
	STATUS specified
	CLOSES @OPEN_QUESTION.UneRecommandationEstExamineeAvantDEtreProposeeALaRatification
	RATIONALE "rien dans le defaut ne tient au projet : toute question qui porte une"
		+ "recommandation, dans tout corpus, se lit comme pre-approuvee"
	REJECTED "specifique au projet, portee par le corpus seul : la prochaine session sur un autre"
		+ "projet referait la meme faute"
	SOURCE "arbitrage utilisateur du 2026-09-12, PR #63"

DECISION LaCommandeDeFusionPousseLeDepotDuCorpusParSonFluxDeTravail
	DESC "la regle est generale et vit dans ~/.claude/commands/awawa-pr-merged.md, section 4 : «"
		+ "Push the repository that holds the corpus, by its own workflow — a branch and a pull"
		+ "request, never its default branch »"
	DESC "la ligne « Push the private context repository » est retiree : ou vit le corpus est un"
		+ "fait du projet, que la commande ne nomme plus"
		REF @DECISION.LeCorpusVitDansLeDepotPublic
	DESC "la commande est retiree le meme jour : la promotion voyage avec la pull request de tache,"
		+ "et la regle n'a plus de ligne a corriger"
		REF @DECISION.LeCorpusRemplaceLaChecklistDeFusion:v2
	STATUS specified
	CLOSES @OPEN_QUESTION.LaCommandeDeFusionOrdonneEncoreUnPushDuDepotPrive
	RATIONALE "la commande sert tout projet a corpus awawa ; sa section 3 disait deja « follow that"
		+ "repository's own workflow, a branch and a pull request », la ligne de la section 4"
		+ "contredisait ce que la section 3 prescrivait"
	REJECTED "garder la ligne et porter un contournement propre au projet dans AGENTS.md : un fait"
		+ "perime dans une commande generale se relit a chaque fusion de chaque projet"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION LeRapportDUsageNettoieUneBrancheOrphelineAvantDeCouperLaSienne
	DESC "la regle est generale et vit dans ~/.claude/commands/awawa-usage-report.md, section 1 :"
		+ "si docs/usage-report-pr-<N> existe, git rev-list origin/<base>..<branche> vide signifie"
		+ "une orpheline — git worktree remove du worktree qui la tient, git branch -D, puis couper"
		+ "a neuf ; non vide, couper docs/usage-report-pr-<N>-2"
	DESC "sans objet le meme jour : le rapport se commite sur la branche de tache, il n'y a plus de"
		+ "branche docs/usage-report-pr-<N> a couper"
		REF @DECISION.UnRapportDUsageEstCommiteDansLaPrDeTacheParUneSessionIndependante
	STATUS specified
	CLOSES @OPEN_QUESTION.LeRelancementDUnRapportDUsageButeSurSaBranche
	RATIONALE "le premier rapporteur de la PR #65 est mort sur une limite de session en laissant sa"
		+ "branche extraite, vide, dans son worktree ; a la cloture de la PR #68 cette branche"
		+ "etait encore tenue par ce worktree, et sa suppression a exige de retirer le worktree"
		+ "d'abord"
	REJECTED "git branch -D seul : git refuse de supprimer une branche extraite dans un worktree,"
		+ "et c'est precisement l'etat que laisse un agent mort"
	REJECTED "toujours suffixer le nom : la branche orpheline resterait, et la suivante porterait"
		+ "un nom sans rapport avec son contenu"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION LaRevueSansRetourNeLanceAucunAgent
	DESC "la regle est generale et vit dans ~/.claude/commands/awawa-pr-review.md, section 0, entre"
		+ "les etapes 1 et 2 : « check there is feedback to act on » — gh pr view --json"
		+ "reviews,comments et l'API des commentaires de revue ; les trois vides, aucun agent, une"
		+ "ligne le dit, et la verification de base et de mergeable revient a la fusion"
	DESC "la revue CI peut arriver apres ce controle : un appel ulterieur de la commande la prend"
	STATUS specified
	CLOSES @OPEN_QUESTION.LaRevueSansRetourLanceQuandMemeUnAgent
	RATIONALE "sur la PR #65 : 0 revue, 0 fil, 0 commentaire ; l'agent a couru 2 min 33 s et 26"
		+ "appels Bash pour l'etablir, puis a poste « review addressed » sur une revue qui"
		+ "n'existait pas"
	REJECTED "lancer l'agent pour qu'il constate lui-meme qu'il n'y a rien : un appel gh dans la"
		+ "session pilote rend le meme verdict pour rien"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION UnDescRenduFauxEstSupprimeDansLeMemeCommit
	DESC "quand une decision ne remplace qu'une phrase d'une decision implemented, le DESC rendu"
		+ "faux est supprime ou reduit a ce qui reste vrai dans le meme commit ; le REF sortant de"
		+ "la nouvelle decision est la trace"
	DESC "une decision entiere ne passe par une successeure :v2 avec SUPERSEDES que quand sa"
		+ "lecture change, pas pour une phrase"
		REF @DECISION.UneDecisionRetireeNommeSaSuccesseure
	DESC "applique : le troisieme DESC de la decision sur la save ordinaire ne parle plus que de"
		+ "SaveSectionsReaderService"
		REF @DECISION.UneFusionProduitUneSaveOrdinaire
		REF @DECISION.LesControleursDeSectionRecoiventLeTexteValide
	STATUS specified
	CLOSES @OPEN_QUESTION.UnRemplacementPartielDUneDecisionImplementeeNEstPasMarque
	RATIONALE "verifie le 2026-09-13 : LoadSaveFileViewModel.ts ne porte plus de champ sections et"
		+ "aucun controleur ne nomme SaveSections, la phrase etait fausse depuis la PR #65 ; une"
		+ ":v2 de soixante lignes pour une phrase est hors de proportion, et un context qui"
		+ "atteignait l'ancienne decision lisait la phrase fausse sans aucun drapeau"
	REJECTED "une successeure :v2 pour toute contradiction partielle : recopie l'entite entiere, et"
		+ "SUPERSEDES ne sait pas dire que seule une phrase a change"
	REJECTED "laisser la phrase et compter sur le REF de la nouvelle decision : le REF est une"
		+ "arete, pas un drapeau, et aucune regle de lint ne compare deux entites"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION UneRecommandationEstUnChampAvecSonRejet
	DESC "SCHEMA OPEN_QUESTION declare FIELD RECOMMENDATION string, avec un REJECTED REQUIRED niche"
		+ "dessous : une recommandation qui n'a pas affronte son alternative ne s'ecrit pas"
	DESC "les recommandations en prose « recommandation : » sont converties une fois : trois"
		+ "portaient une alternative examinee et passent en RECOMMENDATION, trois n'en portaient"
		+ "aucune et deviennent un DESC « a trancher, sans alternative examinee »"
	DESC "« a trancher : » et « constat : » restent des DESC, ce ne sont pas des recommandations"
	STATUS implemented
	CLOSES @OPEN_QUESTION.LaRecommandationDUneQuestionEstUnChampAvecSonRejet
	RATIONALE "recompte du 2026-09-13 : les quatorze prefixes de questions.awawa etaient six «"
		+ "recommandation : », sept « a trancher : », un « constat : » ; seuls les six etaient des"
		+ "recommandations, et inventer apres coup un REJECTED aux trois sans alternative aurait"
		+ "fabrique l'examen que le champ doit attester"
	RATIONALE "la regle generale d'examen avant ratification gouverne la session qui lit ; ce champ"
		+ "gouverne l'ecriture, les deux ne se contredisent pas"
		REF @DECISION.UneRecommandationEstExamineeAvantLaRatificationEstUneRegleGenerale
	REJECTED "un prefixe de prose : indistinguable d'une recommandation examinee, et lu par aucune"
		+ "commande"
	REJECTED "un REJECTED post hoc sur chaque recommandation existante : un examen que personne n'a"
		+ "fait"
	SPEC "toute RECOMMENDATION d'une OPEN_QUESTION porte au moins un REJECTED, et aucun DESC ne"
		+ "commence par « recommandation : »"
		IMPL "docs/_schema.awawa::FIELD RECOMMENDATION string"
		IMPL "docs/questions.awawa"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION UneAncreSousSpecNommeUnFichierOuUnSymbole
	DESC "un IMPL niche sous SPEC nomme un fichier ou un symbole ; un repertoire seulement pour une"
		+ "obligation qui porte sur toute une couche, et le SPEC le dit alors"
	DESC "discipline, pas schema : une ancre est path[:line][::literal], aucun shape ne s'y"
		+ "applique et L016 resout un repertoire ; l'application attend une option de l'outil"
	STATUS specified
	CLOSES @OPEN_QUESTION.UneAncreDeRepertoireSousSpecEstInterdite
	RATIONALE "recompte du 2026-09-13 : 44 des 180 ancres IMPL du corpus pointent un repertoire,"
		+ "sur lesquelles L016 ne se declenchera jamais ; une obligation d'absence — « aucun"
		+ "controleur n'importe » — n'a de toute facon pas de litteral a ancrer"
	REJECTED "un shape sur les ancres : le binaire ne connait que le terme anchor, un shape refuse"
		+ "les references et ne s'applique pas a ce terme"
	REJECTED "reecrire les 44 ancres maintenant : la plupart portent des obligations de couche,"
		+ "formulees comme telles"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION AgentsMdNommeUneEntiteModeleParType
	DESC "AGENTS.md, section « Corpus de specification », nomme une entite modele par type a lire"
		+ "avec awawa show avant awawa new : une decision, une decision avec SUPERSEDES et SPEC,"
		+ "une question, une tache"
	STATUS implemented
	CLOSES @OPEN_QUESTION.UnModeleDEntiteEviteLaLectureDesFichiersDuCorpus
	RATIONALE "l'agent de la PR #65 a lu quatre plages sed et la tete de douze fichiers pour"
		+ "trouver la forme ; awawa new n'imprime que les types des champs, pas un exemple rempli"
	REJECTED "un docs/_example.awawa : la marche du workspace le charge, status compte ses entites"
		+ "et lint les valide"
		REF @DECISION.LeCorpusEstDecoupeParDomaine
	REJECTED "un fichier prefixe d'un point, saute par la marche : invisible a l'outil, il"
		+ "vieillirait sans diagnostic"
	SPEC "AGENTS.md nomme une entite modele par type, toutes existantes dans le corpus"
		IMPL "AGENTS.md::Avant `awawa new`"
	SOURCE "PR #68 fusionnee, arbitrage utilisateur du 2026-09-13, PR #69"

DECISION UneVueQueLeCorpusRendDejaNEstPasRecopieeDedans
	DESC "rien n'est ecrit dans le corpus que le corpus rende deja : ni graphe de dependances en"
		+ "commentaire, les aretes AFTER le portant, ni decision de decoupage d'une tache, les"
		+ "entites TASK issues du decoupage la portant"
	DESC "un decoupage de tache n'est pas un arbitrage : il applique une regle generale deja"
		+ "enregistree, et ce qu'il a d'irreductible — pourquoi telle ligne SPEC atterrit sur tel"
		+ "livrable — s'ecrit en RATIONALE sur ce livrable"
		REF @DECISION.UneTacheEstUneEntiteParPullRequest
	DESC "une regle promue dans les instructions generales ne laisse rien ici une fois la promotion"
		+ "livree : ni entite de promotion, ni decision projet qui la reenonce ; la question de"
		+ "portee, elle, vit dans le corpus tant qu'elle n'est pas tranchee"
	DESC "ce qui reste apres une promotion est ce que le projet possede en propre — une garde, un"
		+ "script, une ancre — jamais la reformulation de la regle ni l'attestation de s'y"
		+ "conformer"
	DESC "les deux entites de promotion deja fusionnees restent, chacune portant ce qui n'a pas"
		+ "voyage avec sa regle ; elles ne sont pas retro-retirees"
		REF @DECISION.LaRegleDuCorpsDePrEstGeneraleEtVaDansCommandsMd
		REF @DECISION.UneRecommandationEstExamineeAvantLaRatificationEstUneRegleGenerale
	STATUS implemented
	RATIONALE "le graphe ASCII d'entete de taches.awawa a ete edite a la main a chaque decoupage"
		+ "depuis son ecriture : c'est exactement l'information derivee que le manuel de l'outil"
		+ "interdit de tenir ailleurs, fausse au commit suivant et lue par aucune commande"
	RATIONALE "la decision de decoupage du harnais de tests d'UI ne portait, hors du DESC des"
		+ "quatre taches, que des alternatives que la regle generale avait deja ecartees ; sa"
		+ "suppression ne perd aucune phrase, les RATIONALE de T40, T41 et T42 disant deja pourquoi"
		+ "chaque ligne transverse atterrit chez elles"
	RATIONALE "constate en revue de la PR #75 : la regle du bloc Act en une ligne a tenu trois"
		+ "entites — la regle, sa promotion, la question de sa portee — dont aucune n'a survecu a"
		+ "la livraison ; TEST-1 la gouverne depuis delairec/.ai#18, et les deux fichiers de"
		+ "scenarios s'y conforment sans qu'aucune entite l'atteste"
	RATIONALE "le corpus n'atteste nulle part la conformite a une instruction generale : il cite"
		+ "CFG-2, STD-6, ARCH-CA et TEST-1 en RATIONALE, jamais en SPEC"
	REJECTED "garder le graphe ASCII des dependances de taches : aucune commande ne le lit et"
		+ "status, refs et context rendent les memes aretes"
	REJECTED "une DECISION par decoupage de tache : elle recopie le DESC des entites produites et"
		+ "reenonce des REJECTED deja portes par la regle generale"
	REJECTED "passer la decision de decoupage superseded plutot que la supprimer : elle n'a jamais"
		+ "existe hors de la branche de la PR #75, et le schema exigerait une successeure qui"
		+ "n'existe pas"
	REJECTED "une entite de promotion par regle partie dans les instructions generales : son sujet"
		+ "n'est pas le projet"
	REJECTED "garder une decision projet qui reenonce une regle devenue generale : c'est un doublon"
		+ "tenu a la main, qu'aucune commande ne compare a son original"
	SPEC "taches.awawa ne porte aucune vue des dependances hors des champs AFTER"
		IMPL "docs/taches.awawa"
	SOURCE "revue de la PR #75, arbitrage utilisateur du 2026-09-14"

DECISION UneInterrogationEnCommentaireNommeLaQuestionOuverteQuiLaPorte
	DESC "une interrogation laissee en commentaire dans une source est conservee et nomme, sur la"
		+ "ligne suivante, la question ouverte qui la porte"
	DESC "le commentaire est un panneau vers l'entite, pas son domicile : la matiere vit dans la"
		+ "question ouverte, que status rend"
	STATUS implemented
	RATIONALE "arbitrage de l'utilisateur : le commentaire est utile la ou la table se lit, et le"
		+ "supprimer emporte l'interrogation avec lui, ce que T38 avait fait"
	RATIONALE "aucune commande ne lit un commentaire : l'interrogation laissee la seule n'atteint"
		+ "pas la session suivante, d'ou l'entite a cote"
	RATIONALE "exception a STD-5 propre au projet, pas de regle generale a proposer : le panneau ne"
		+ "vaut que parce qu'une entite indexee existe a l'autre bout, ce que seul un projet a"
		+ "corpus offre"
	REJECTED "supprimer le commentaire et ne garder que la question ouverte : le lecteur de la"
		+ "table des libelles ne trouve plus l'interrogation la ou elle porte"
	REJECTED "garder le commentaire seul, sans entite : aucune commande ne le lit et status ne le"
		+ "compte pas"
	SPEC "l'interrogation de worldObjectLabels sur les epaves procedurales nomme la question"
