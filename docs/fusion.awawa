// La fusion : ce qu'elle promet, ce qu'elle refuse de fabriquer.
DECISION LaFusionPorteExactementDeuxSavesParDossier
	DESC "un sous-dossier d'entree est valide quand il contient exactement deux fichiers de save ;"
		+ "tout autre nombre est ecarte"
	DESC "un dossier ecarte est nomme sur la sortie d'erreur avec le nombre qui l'a disqualifie :"
		+ "l'ecart silencieux est refuse des deux cotes de la regle"
	STATUS implemented
	RATIONALE "l'UI etait deja a deux fichiers, save A et save B : la boucle d'accumulation du CLI"
		+ "faisait dire deux choses differentes aux deux points d'entree du meme outil"
	RATIONALE "arbitrage de l'utilisateur en revue : rester sur deux saves au maximum par fusion"
	REJECTED "accumuler les saves d'un dossier de plus de deux fichiers"
	REJECTED "ecarter un dossier sans le nommer, comme un dossier d'un seul fichier l'etait deja"
	SPEC "la documentation publique dit deux saves, parce que c'est le code qui a change"
		IMPL "README.md"
	SOURCE "decision du 2026-09-09, revue de la PR #42"

DECISION UneIdentiteDeJoueurEstPorteeParLEntree
	DESC "une identite de joueur est portee par l'entree, jamais par son identifiant :"
		+ "l'identifiant est un compte Steam, que le jeu reutilise d'une partie a l'autre"
	DESC "le role d'hote est donc applique par la position de l'entree dans la save A, jamais par"
		+ "egalite d'identifiant ni par nom"
	DESC "un identifiant de joueur n'est jamais regenere : la renumerotation changeait le compte"
		+ "que nomme une entree, pour rien — aucune entree ne le reference en retour"
	DESC "consequence assumee : deux entrees joueur peuvent porter le meme compte Steam, cas que la"
		+ "deduplication par nom laisse passer par construction"
	STATUS implemented
	RATIONALE "l'identifiant n'est unique ni entre deux saves ni, formellement, a l'interieur d'une"
		+ "seule"
	RATIONALE "calculer le role apres la renumerotation ferait dependre la justesse d'une regle de"
		+ "role d'une regle d'identifiants qui n'en sait rien, et eclaterait une regle de jeu sur"
		+ "deux modules"
	RATIONALE "comparer par nom ne marche pas non plus : rien ne garantit l'unicite des noms dans"
		+ "une meme save, et deux homonymes ressortiraient tous deux hotes"
	RATIONALE "la save B apporte l'hote quand la save A n'a aucune entree joueur — repli"
		+ "strictement borne a ce cas, le seul atteignable puisque la validation refuse en amont"
		+ "une section joueurs non vide sans hote"
	REJECTED "designer l'hote par egalite d'identifiant"
	REJECTED "designer l'hote par egalite de nom"
	REJECTED "fabriquer un identifiant neuf pour le joueur de la save B dont l'identifiant figure"
		+ "deja en save A : la valeur ne designerait aucun compte reel"
	SPEC "la deduplication et le role d'hote sont decides dans un seul module de regle"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergePlayers.ts"
	SOURCE "decision du 2026-09-07, T29, PR #39 ; etendue en revue de T16, PR #41"

DECISION UneFusionQuiProduitUnFichierResteUnSucces
	DESC "une fusion qui produit un fichier est un succes : le fichier est ecrit, le telechargement"
		+ "offert, le code de retour reste zero"
	DESC "un defaut de ce fichier est signale, pas transforme en echec : la sortie est revalidee et"
		+ "ses erreurs remontent dans un canal propre, jamais fondues dans les listes par fichier"
		+ "d'entree, qui n'ont pas la meme attribution"
	DESC "l'operation qui n'a pas pu produire de resultat, elle, a une issue de presenter dediee et"
		+ "un code de retour non nul"
	DESC "dans le CLI, le marqueur d'echec sur une ligne ne vaut pas code de retour non nul : il"
		+ "marque une save invalide"
	STATUS implemented
	RATIONALE "refuser d'ecrire couplerait la disponibilite de la fusion a la severite du"
		+ "validateur"
	RATIONALE "les avertissements de la revalidation ne sont pas remontes : annoncer que la save a"
		+ "ete creee par une version plus ancienne du jeu, a propos d'un fichier que l'outil vient"
		+ "d'ecrire, est un contresens. Ce vocabulaire ne s'applique pas a une sortie"
	RATIONALE "surcout mesure de la revalidation : +25 % d'une fusion, la section des objets du"
		+ "monde passant desormais par ajv"
	REJECTED "refuser d'ecrire un fichier que la revalidation trouve invalide"
	REJECTED "une option qui coupe l'etape de revalidation"
	REJECTED "remonter les avertissements de la revalidation au meme titre que ceux des entrees"
	SPEC "le cas d'utilisation valide ses deux entrees, fusionne, puis valide ce qu'il a produit,"
		+ "sans branche"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.ts"
	SOURCE "decision du 2026-09-07, revue de T26 ; livree par T28, PR #59"

DECISION AucunCanalDAvertissementDeFusionSansProducteur
	DESC "la fusion n'expose aucun canal d'avertissement tant qu'aucune regle n'en produit : un"
		+ "canal sans producteur est du code mort"
	DESC "forme arretee pour le jour ou une regle en produira : une liste unique portant sur la"
		+ "sortie, du nom du champ de l'objet de sortie du port jusqu'au ViewModel"
	STATUS specified
	RATIONALE "les deux candidats n'en sont pas : une section vide est legitime dans une save"
		+ "valide, et la collision d'identifiants est un defaut corrige, pas une fonctionnalite a"
		+ "documenter"
	RATIONALE "le nom du canal est le meme de bout en bout ; ses voisins de la meme interface"
		+ "portent deja cette forme, sans suffixe Messages, parce que les messages de validation"
		+ "voyagent comme un couple message plus localisation et non comme une chaine"
	REJECTED "ouvrir le canal des maintenant, en prevision"
	REJECTED "fondre les avertissements de sortie dans les listes par fichier d'entree"
	SOURCE "decision du 2026-09-10, T27, PR #54 ; nom arrete en revue de la PR #59"

DECISION LArtefactDuFichierFusionneNEstPasUnObjetDuDomaine
	DESC "l'objet valeur de save fusionnee et sa fabrique disparaissent : un nom de fichier et un"
		+ "contenu serialise ne sont pas un objet du domaine"
	DESC "le port de fusion declare son propre type de resultat, nom de fichier et contenu, type"
		+ "d'application"
	DESC "l'issue de fusion inutilisable reste atteignable : le cas d'utilisation la choisit par"
		+ "une branche explicite sur un contenu vide, au lieu de rattraper une erreur de donnee de"
		+ "domaine"
	STATUS specified
	CLOSES @OPEN_QUESTION.SortDeMergedSaveValueObject
	RATIONALE "un type d'infrastructure ne traverse pas un port, donc le type de resultat est"
		+ "declare la ou vit le port, en application"
	RATIONALE "l'invariant de l'objet valeur etait vide : une assertion de chaine non vide sur un"
		+ "blob"
	REJECTED "supprimer aussi l'issue de fusion inutilisable du port presenteur, de l'UI et de la"
		+ "CLI : changement de comportement visible, hors du perimetre comportement inchange de T37"
	REJECTED "renommer l'objet valeur en type d'infrastructure : un type d'infrastructure ne"
		+ "traverse pas un port"
	REJECTED "faire rendre au port les sections fusionnees avec un second port de serialisation :"
		+ "un port et un aller-retour de plus sans rien donner au cas d'utilisation"
	SPEC "aucun objet valeur du domaine ne porte un nom de fichier ni un contenu serialise"
		IMPL "packages/core-mapping/src/domain/valueObjects"
	SPEC "le port de fusion declare le type de resultat qu'il rend"
		IMPL "packages/core-mapping/src/application/ports/SaveFilesMergerPort.ts"
	SOURCE "decision du 2026-09-12, arbitrage utilisateur au lancement de T37 partie A"
