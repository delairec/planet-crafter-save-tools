// La fusion : ce qu'elle promet, ce qu'elle refuse de fabriquer.
DECISION LaFusionPorteExactementDeuxSavesParDossier
	DESC "un sous-dossier d'entree est valide quand il contient exactement deux fichiers de save ;"
		+ "tout autre nombre est ecarte"
	DESC "un dossier ecarte est nomme sur la sortie d'erreur avec le nombre qui l'a disqualifie :"
		+ "l'ecart silencieux est refuse des deux cotes de la regle"
	STATUS implemented
	RATIONALE "l'UI etait deja a deux fichiers, save A et save B : la boucle d'accumulation du CLI"
		+ "faisait dire deux choses differentes aux deux points d'entree du meme outil"
	RATIONALE "arbitrage de l'utilisateur en revue : rester sur deux saves au maximum par fusion"
	REJECTED "accumuler les saves d'un dossier de plus de deux fichiers"
	REJECTED "ecarter un dossier sans le nommer, comme un dossier d'un seul fichier l'etait deja"
	SPEC "la documentation publique dit deux saves, parce que c'est le code qui a change"
		IMPL "README.md"
	SOURCE "decision du 2026-09-09, revue de la PR #42"

DECISION UneIdentiteDeJoueurEstPorteeParLEntree
	DESC "une identite de joueur est portee par l'entree, jamais par son identifiant :"
		+ "l'identifiant est un compte Steam, que le jeu reutilise d'une partie a l'autre"
	DESC "le role d'hote est donc applique par la position de l'entree dans la save A, jamais par"
		+ "egalite d'identifiant ni par nom"
	DESC "un identifiant de joueur n'est jamais regenere : la renumerotation changeait le compte"
		+ "que nomme une entree, pour rien — aucune entree ne le reference en retour"
	DESC "consequence assumee : deux entrees joueur peuvent porter le meme compte Steam, cas que la"
		+ "deduplication par nom laisse passer par construction"
	STATUS implemented
	RATIONALE "l'identifiant n'est unique ni entre deux saves ni, formellement, a l'interieur d'une"
		+ "seule"
	RATIONALE "calculer le role apres la renumerotation ferait dependre la justesse d'une regle de"
		+ "role d'une regle d'identifiants qui n'en sait rien, et eclaterait une regle de jeu sur"
		+ "deux modules"
	RATIONALE "comparer par nom ne marche pas non plus : rien ne garantit l'unicite des noms dans"
		+ "une meme save, et deux homonymes ressortiraient tous deux hotes"
	RATIONALE "la save B apporte l'hote quand la save A n'a aucune entree joueur — repli"
		+ "strictement borne a ce cas, le seul atteignable puisque la validation refuse en amont"
		+ "une section joueurs non vide sans hote"
	REJECTED "designer l'hote par egalite d'identifiant"
	REJECTED "designer l'hote par egalite de nom"
	REJECTED "fabriquer un identifiant neuf pour le joueur de la save B dont l'identifiant figure"
		+ "deja en save A : la valeur ne designerait aucun compte reel"
	SPEC "la deduplication et le role d'hote sont decides dans un seul module de regle"
		IMPL "packages/core-mapping/src/domain/rules/merge/mergePlayers.ts"
	SOURCE "decision du 2026-09-07, T29, PR #39 ; etendue en revue de T16, PR #41"

DECISION UneFusionQuiProduitUnFichierResteUnSucces
	DESC "une fusion qui produit un fichier est un succes : le fichier est ecrit, le telechargement"
		+ "offert, le code de retour reste zero"
	DESC "un defaut de ce fichier est signale, pas transforme en echec : la sortie est revalidee et"
		+ "ses erreurs remontent dans un canal propre, jamais fondues dans les listes par fichier"
		+ "d'entree, qui n'ont pas la meme attribution"
	DESC "l'operation qui n'a pas pu produire de resultat, elle, a une issue de presenter dediee et"
		+ "un code de retour non nul"
	DESC "dans le CLI, le marqueur d'echec sur une ligne ne vaut pas code de retour non nul : il"
		+ "marque une save invalide"
	STATUS implemented
	RATIONALE "refuser d'ecrire couplerait la disponibilite de la fusion a la severite du"
		+ "validateur"
	RATIONALE "les avertissements de la revalidation ne sont pas remontes : annoncer que la save a"
		+ "ete creee par une version plus ancienne du jeu, a propos d'un fichier que l'outil vient"
		+ "d'ecrire, est un contresens. Ce vocabulaire ne s'applique pas a une sortie"
	RATIONALE "surcout mesure de la revalidation : +25 % d'une fusion, la section des objets du"
		+ "monde passant desormais par ajv"
	REJECTED "refuser d'ecrire un fichier que la revalidation trouve invalide"
	REJECTED "une option qui coupe l'etape de revalidation"
	REJECTED "remonter les avertissements de la revalidation au meme titre que ceux des entrees"
	SPEC "le cas d'utilisation valide ses deux entrees, fusionne, puis valide ce qu'il a produit,"
		+ "sans branche"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.ts"
	SOURCE "decision du 2026-09-07, revue de T26 ; livree par T28, PR #59"

DECISION AucunCanalDAvertissementDeFusionSansProducteur
	DESC "la fusion n'expose aucun canal d'avertissement tant qu'aucune regle n'en produit : un"
		+ "canal sans producteur est du code mort"
	DESC "forme arretee pour le jour ou une regle en produira : une liste unique portant sur la"
		+ "sortie, du nom du champ de l'objet de sortie du port jusqu'au ViewModel"
	STATUS specified
	RATIONALE "les deux candidats n'en sont pas : une section vide est legitime dans une save"
		+ "valide, et la collision d'identifiants est un defaut corrige, pas une fonctionnalite a"
		+ "documenter"
	RATIONALE "le nom du canal est le meme de bout en bout ; ses voisins de la meme interface"
		+ "portent deja cette forme, sans suffixe Messages, parce que les messages de validation"
		+ "voyagent comme un couple message plus localisation et non comme une chaine"
	REJECTED "ouvrir le canal des maintenant, en prevision"
	REJECTED "fondre les avertissements de sortie dans les listes par fichier d'entree"
	SOURCE "decision du 2026-09-10, T27, PR #54 ; nom arrete en revue de la PR #59"

DECISION LArtefactDuFichierFusionneNEstPasUnObjetDuDomaine
	DESC "l'objet valeur de save fusionnee et sa fabrique disparaissent : un nom de fichier et un"
		+ "contenu serialise ne sont pas un objet du domaine"
	DESC "le port de fusion declare son propre type de resultat, nom de fichier et contenu, type"
		+ "d'application"
	DESC "l'issue de fusion inutilisable reste atteignable : le cas d'utilisation la choisit par"
		+ "une branche explicite sur un contenu vide, au lieu de rattraper une erreur de donnee de"
		+ "domaine"
	STATUS superseded
	CLOSES @OPEN_QUESTION.SortDeMergedSaveValueObject
	RATIONALE "un type d'infrastructure ne traverse pas un port, donc le type de resultat est"
		+ "declare la ou vit le port, en application"
	RATIONALE "l'invariant de l'objet valeur etait vide : une assertion de chaine non vide sur un"
		+ "blob"
	REJECTED "supprimer aussi l'issue de fusion inutilisable du port presenteur, de l'UI et de la"
		+ "CLI : changement de comportement visible, hors du perimetre comportement inchange de T37"
	REJECTED "renommer l'objet valeur en type d'infrastructure : un type d'infrastructure ne"
		+ "traverse pas un port"
	REJECTED "faire rendre au port les sections fusionnees avec un second port de serialisation :"
		+ "un port et un aller-retour de plus sans rien donner au cas d'utilisation"
	SPEC "aucun objet valeur du domaine ne porte un nom de fichier ni un contenu serialise"
		IMPL "packages/core-mapping/src/domain/valueObjects"
	SPEC "le port de fusion declare le type de resultat qu'il rend"
		IMPL "packages/core-mapping/src/application/ports/SaveFilesMergerPort.ts"
	SOURCE "decision du 2026-09-12, arbitrage utilisateur au lancement de T37 partie A, PR #62"

DECISION LeCasDUtilisationDeFusionInvoqueLesReglesDuDomaine
	DESC "le port de fusion unique est decoupe en deux : un lecteur qui rend les sections d'une"
		+ "save sous le modele de fusion et ses lignes illisibles, un serialiseur qui nomme le"
		+ "fichier fusionne et ecrit son contenu"
	DESC "le cas d'utilisation appelle lui-meme les regles de fusion et de resolution des"
		+ "identifiants entre les deux ports"
	DESC "le nom de fichier et le contenu serialise restent un type d'application declare par le"
		+ "port du serialiseur"
	DESC "l'issue de fusion inutilisable a un vrai declencheur : une save dont une ligne n'a pas pu"
		+ "etre lue, que le lecteur rapporte au lieu de lever une erreur d'infrastructure"
	DESC "le lecteur parcourt la section des objets du monde a la lecture, sinon une ligne"
		+ "illisible de cette section n'est connue qu'apres la fusion"
	STATUS superseded
	SUPERSEDES @DECISION.LArtefactDuFichierFusionneNEstPasUnObjetDuDomaine
	RATIONALE "la branche sur un contenu vide etait morte : le serialiseur emet toujours ses"
		+ "separateurs et son terminateur, et l'assertion de chaine non vide qu'elle remplacait"
		+ "l'etait autant. Le rejet enregistre, changement de comportement visible, etait faux"
	RATIONALE "avec un port avalant quatre chaines et rendant un fichier, c'est l'infrastructure"
		+ "qui invoquait les regles du domaine et le cas d'utilisation n'orchestrait rien"
		+ "(ARCH-CA-APP-1) ; l'erreur d'infrastructure du port traversait le cas d'utilisation sans"
		+ "etre vue (ARCH-CA-RUL-4)"
	RATIONALE "le port du serialiseur prend des objets nommes : deux noms de fichier de meme type"
		+ "en position ne se distinguent plus a l'appel (STD-6)"
	REJECTED "garder la branche morte sur le contenu vide : une selection d'issue factice dans le"
		+ "cas d'utilisation"
	REJECTED "supprimer l'issue de fusion inutilisable : elle a desormais un declencheur reel"
	REJECTED "un seul port lecteur-serialiseur a deux methodes : deux capacites distinctes, et"
		+ "chaque cas d'utilisation futur n'a besoin que d'une des deux"
	SPEC "le cas d'utilisation de fusion importe les regles de fusion du domaine et les appelle"
		+ "entre la lecture et la serialisation"
		IMPL "packages/core-mapping/src/application/MergeSaveFiles.ts"
	SPEC "le lecteur rend les lignes illisibles et n'en leve aucune erreur"
		IMPL "packages/core-mapping/src/infrastructure/MergeSourceReaderService.ts"
	SPEC "le serialiseur nomme le fichier et ecrit le contenu, depuis des objets nommes"
		IMPL "packages/core-mapping/src/application/ports/MergedSaveSerializerPort.ts"
	SOURCE "decision du 2026-09-12, revue d'architecture de la PR #62 par l'utilisateur"

DECISION UneFusionProduitUneSaveOrdinaire
	DESC "un resultat de fusion est une save ordinaire : la resolution des conflits d'identifiants"
		+ "rend une SaveSections, entrees de la save A puis de la save B, sections a entree unique"
		+ "mises en tableau ; l'origine d'une entree n'a plus de consommateur apres elle"
	DESC "un seul analyseur de save et un seul serialiseur : SaveSectionsParserPort, deja le port"
		+ "du chargement, rend une SaveSections et ses lignes illisibles aux deux cas d'utilisation"
		+ "; SaveSectionsSerializerPort ecrit une SaveSections en contenu sans rien savoir d'une"
		+ "fusion"
	DESC "SaveSectionsReaderService porte une SaveSections ; l'UI n'importe plus"
		+ "shared-save-processing"
	DESC "le nommage du fichier fusionne est une fonction pure de l'application, nameMergedFile,"
		+ "depuis un objet nomme ; ce n'est pas une capacite externe, donc pas un port"
	DESC "SaveSections, InventoryEntry et WorldObjectEntry sont le modele de save du domaine et"
		+ "vivent dans domain/save ; MergedSaveSections et EntriesByOrigin restent internes a la"
		+ "fusion, entre mergeSaveSections et resolveIdConflicts"
		REF @DECISION.LesReglesDeFusionRecoiventUnModeleDeFusion
	DESC "le cas d'utilisation appelle lui-meme les regles de fusion et de resolution des"
		+ "identifiants entre l'analyseur et le serialiseur"
	DESC "l'issue de fusion inutilisable garde son declencheur : une ligne illisible rapportee par"
		+ "l'analyseur, qui parcourt la section des objets du monde a la lecture"
	STATUS implemented
	SUPERSEDES @DECISION.LeCasDUtilisationDeFusionInvoqueLesReglesDuDomaine
	RATIONALE "revue de la PR #62 : un service de serialisation propre aux resultats de fusion n'a"
		+ "pas de raison d'etre, et un second port de lecture non plus quand le chargement en a"
		+ "deja un. MergedSaveSections n'existait que pour la resolution des identifiants, qui en"
		+ "est le dernier consommateur : c'est elle qui rend la save"
	RATIONALE "l'ordre A puis B a l'ecriture est une regle de fusion ; elle vivait dans le"
		+ "serialiseur d'infrastructure et revient au domaine avec ce changement"
	RATIONALE "sortie de reference inchangee sur les deux dossiers d'entree, somme md5 verifiee"
		+ "avant et apres ; 748 tests, type-check, gardes et audit verts"
	REJECTED "un serialiseur propre au resultat de fusion, prenant les sections par origine : un"
		+ "service pour un seul cas, et une regle de fusion en infrastructure"
	REJECTED "un second port de lecture a cote de SaveSectionsParserPort, l'un rendant le tuple"
		+ "wire au chargement et l'autre le modele de save a la fusion : deux ports lisant une save"
		+ "depuis son contenu (seconde passe de la revue de la PR #62)"
	REJECTED "un port pour nommer le fichier fusionne : une fonction pure n'est pas une capacite"
		+ "externe (ARCH-CA-APP-3)"
	REJECTED "laisser le modele de save sous rules/merge : un analyseur et un serialiseur de save"
		+ "ordinaire ne prennent pas un modele de fusion"
	REJECTED "une regle d'assemblage distincte apres resolveIdConflicts : un troisieme appel de"
		+ "domaine et un type intermediaire pour une projection que le dernier consommateur de"
		+ "l'origine fait lui-meme"
	SPEC "resolveIdConflicts rend une SaveSections, entrees de la save A avant celles de la save B"
		IMPL "packages/core-mapping/src/domain/rules/merge/resolveIdConflicts.ts"
	SPEC "l'analyseur rend une SaveSections et ses lignes illisibles, sans lever d'erreur, au"
		+ "chargement comme a la fusion"
		IMPL "packages/core-mapping/src/application/ports/SaveSectionsParserPort.ts"
		IMPL "packages/core-mapping/src/infrastructure/SaveSectionsParserService.ts"
		IMPL "packages/core-mapping/src/application/LoadAndValidateSaveFile.ts"
	SPEC "le serialiseur ecrit une SaveSections et ignore l'origine des entrees"
		IMPL "packages/core-mapping/src/application/ports/SaveSectionsSerializerPort.ts"
		IMPL "packages/core-mapping/src/infrastructure/SaveSectionsSerializerService.ts"
	SPEC "aucun ViewModel ni controleur ne porte ParsedSections, et ui-save-manager ne depend plus"
		+ "de shared-save-processing"
		IMPL "packages/core-mapping/src/presentation/viewModels/LoadSaveFileViewModel.ts"
		IMPL "packages/ui-save-manager/package.json::ui-save-manager"
	SPEC "le nom du fichier fusionne est calcule en application depuis un objet nomme"
		IMPL "packages/core-mapping/src/application/nameMergedFile.ts"
	SPEC "le modele de save vit dans domain/save et aucune regle de fusion ne le declare"
		IMPL "packages/core-mapping/src/domain/save"
	SOURCE "decision du 2026-09-12, revue de la PR #62 par l'utilisateur, deux passes : un resultat"
		+ "de fusion est une save ordinaire, et l'existant se reutilise pour la lire"

DECISION LeParcoursDesDossiersDEntreeLitLExtensionJsonParLeModulePartage
	DESC "isJson quitte initMergeCli : le parcours d'un dossier d'entree retient un fichier de save"
		+ "par hasJsonExtension, seul module a savoir ce qu'est l'extension json"
	DESC "un dossier de deux saves dont l'une porte .JSON est fusionne, la ou il etait annonce"
		+ "comme n'en portant qu'une"
	STATUS implemented
	CLOSES @OPEN_QUESTION.LaCasseDeLExtensionJsonNEstPasLueDeLaMemeFaconPartout
	RATIONALE "la question etait posee hors perimetre : la correction sort de core-mapping et"
		+ "change ce que bun merge ramasse, ce que T38 s'interdisait ; l'utilisateur a etendu le"
		+ "perimetre de la PR #76 pour la prendre"
	RATIONALE "cli-merge declarait shared-save-processing en devDependencies ; le module devient du"
		+ "code de production du package et la dependance passe en dependencies, matrice cli-* vers"
		+ "shared-* respectee"
	REJECTED "garder la sensibilite a la casse et la declarer voulue : elle ne l'est nulle part"
		+ "ailleurs, et le dossier est alors signale comme ne contenant pas deux saves, un"
		+ "diagnostic qui ne nomme pas la cause"
	REJECTED "renvoyer la correction a une tache ulterieure : elle coute une ligne et un cas de"
		+ "test, et la question aurait survecu a la PR qui l'a ouverte"
	SPEC "le parcours d'un dossier d'entree retient un fichier de save par hasJsonExtension, casse"
		+ "de l'extension indifferente"
		IMPL "packages/cli-merge/cli/initMergeCli.js"
		IMPL "packages/cli-merge/cli/initMergeCli.spec.js"
	SPEC "cli-merge declare shared-save-processing en dependance de production"
		IMPL "packages/cli-merge/package.json::cli-merge"
	SOURCE "arbitrage de l'utilisateur du 2026-09-14, revue de la PR #76, fil 4004743738"
