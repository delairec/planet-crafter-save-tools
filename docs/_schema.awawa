SCHEMA *
	DESC "fields legal on every entity of this corpus"
	NAME pascal
	FIELD DESC string
		DESC "what no other field of the entity holds; written only when nothing else carries it"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the prose names, so that it is indexed"
	FIELD RATIONALE string
		CATEGORY reasoning
		DESC "why the entity is as it is"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the prose names, so that it is indexed"
	FIELD SOURCE string
		REPEATABLE
		CATEGORY provenance
		DESC "where the entity came from, in prose; no source type fits: declare it in the same"
			+ "pull request"
		FIELD PR uint
			REPEATABLE
			DESC "the number of the pull request the prose says it was ruled or observed in"
		FIELD REF reference
			REPEATABLE
			CONVERSE SOURCE_OF
			DESC "the USAGE_REPORT, URL, PROJECT or GAME_RELEASE the prose names"
	FIELD STATUS active|archived
		DEFAULT active
		DESC "written only to archive an entity that stopped binding"
	WHEN STATUS active
		GATE error
	WHEN STATUS archived
		GATE suppressed
		FIELD ARCHIVED_ON date
			REQUIRED
			DESC "the day the entity was archived"
		FIELD PURGE true|false
			DEFAULT true
			DESC "whether the cleanup pass deletes the entity; false keeps it"

SHAPE pascal
	DESC "an identifier in PascalCase"
	MATCH "[A-Z][A-Za-z0-9]*"

SHAPE task_id
	DESC "the Conventional Commits type of the task, upper case, then its number in the global"
		+ "sequence"
	MATCH "(BUILD|CHORE|CI|DOCS|FEAT|FIX|PERF|REFACTOR|REVERT|STYLE|TEST)[0-9]+"

SHAPE package_name
	DESC "the manifest name of the package, underscore where the manifest has a hyphen"
	MATCH "(core|util|cli|ui|shared)(_[a-z0-9]+)+"

SHAPE date
	DESC "a calendar day, YYYY-MM-DD"
	MATCH "\d{4}-\d{2}-\d{2}"

SHAPE repo
	DESC "a repository on the forge, owner/name"
	MATCH "[A-Za-z0-9.-]+/[A-Za-z0-9.-]+"

SHAPE url
	DESC "an absolute http or https address"
	MATCH "https?://[^\s\"]+"

SHAPE project_name
	DESC "the short name of a project, upper case"
	MATCH "[A-Z]+"

SHAPE file_name
	DESC "the subject of the report, words joined by underscores"
	MATCH "[A-Za-z0-9]+(_[A-Za-z0-9]+)*"

SHAPE version_segment
	DESC "one dot-separated segment of a released game version, digits only"
	MATCH "[0-9]+"

SHAPE json_key
	DESC "a property name of a JSON row, camelCase"
	MATCH "[a-z][A-Za-z0-9]*"

FIELDSET Ruling
	DESC "the fields shared by the ruling types"
	FIELD REJECTED string
		REQUIRED
		REPEATABLE
		CATEGORY reasoning
		DESC "an alternative considered and refused, including the previous form of this ruling"
			+ "when replaced"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the prose names, so that it is indexed"
	FIELD UNTIL @TASK|string
		CONVERSE RETIRES
		DESC "what retires the ruling: the task whose merge retires it, or the observable condition"

SCHEMA DECISION
	DESC "a ruling the project follows that holds somewhere in the repository"
	INCLUDE @FIELDSET.Ruling
	FIELD SPEC string
		REQUIRED
		REPEATABLE
		DESC "one falsifiable obligation"
		FIELD IMPL anchor
			REQUIRED
			REPEATABLE
			DESC "where the obligation holds: code, config, schema, hook, instructions"
		FIELD ENFORCED_BY anchor
			REPEATABLE
			DESC "the guard, test or workflow that fails when the obligation is broken"
	FIELD APPLIES_TO_PACKAGE @PACKAGE
		REPEATABLE
		CONVERSE GOVERNED_BY
		DESC "the package the ruling is limited to; absent: every package"
	FIELD APPLIES_TO_TASK @TASK
		REPEATABLE
		CONVERSE GOVERNED_BY
		DESC "the task that builds it; removed once the task is archived"
	FIELD RESTS_ON @RULE
		REPEATABLE
		CONVERSE GROUNDS
		DESC "a rule of the save or the game the ruling depends on"
	FIELD ASSUMES @HYPOTHESIS
		REPEATABLE
		CONVERSE GROUNDS
		DESC "a hypothesis the ruling rests on"

SCHEMA PROCESS
	DESC "a ruling on how the work is led, with nothing in the repository to anchor"
	INCLUDE @FIELDSET.Ruling
	FIELD SPEC string
		REQUIRED
		REPEATABLE
		DESC "one falsifiable obligation"
		FIELD ENFORCED_BY anchor
			REPEATABLE
			DESC "the hook or workflow that fails when the obligation is broken"

SCHEMA LIMITATION
	DESC "a known defect of this project left in place; a defect of an external tool is not"
		+ "recorded"
	FIELD SYMPTOM string
		REQUIRED
		DESC "what a user or a developer observes"
	FIELD WORKAROUND string
		REPEATABLE
		DESC "what to do while the defect stands"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the prose names, so that it is indexed"
	FIELD UNTIL @TASK|string
		REQUIRED
		CONVERSE RETIRES
		DESC "the task that fixes it, or the observable condition that makes the fix due"
	FIELD SEEN_IN anchor
		REPEATABLE
		DESC "the code where the defect sits, or the test that pins the current behaviour"
	FIELD APPLIES_TO_PACKAGE @PACKAGE
		REPEATABLE
		CONVERSE LIMITED_BY
		DESC "the package that carries the defect"

SCHEMA OPEN_QUESTION
	DESC "a project-level point left undecided on which a task waits; archived by the pull request"
		+ "that rules it"
	FIELD DESC string
		REQUIRED
		DESC "the question, one statement"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the question names, so that it is indexed"
	FIELD BLOCKS @TASK
		REQUIRED
		REPEATABLE
		CONVERSE BLOCKED_BY
		DESC "the task that cannot proceed until the question is ruled"

SCHEMA TASK
	DESC "a unit of work delivered by one pull request"
	NAME task_id
	FIELD TITLE string
		REQUIRED
		DESC "what the task delivers, in one line"
	FIELD STATUS draft|todo|implemented|archived
		REQUIRED
		DESC "draft: not ratified by the user, no finding reported until ratified; todo: ratified;"
			+ "implemented: merged; archived by the cleanup pass"
	FIELD SPEC string
		REQUIRED
		REPEATABLE
		DESC "one acceptance criterion, observable once delivered; says nothing of how"
		FIELD IMPL anchor
			REPEATABLE
			DESC "the test or the code where the criterion is proven; written at delivery"
	FIELD AFTER @TASK
		REPEATABLE
		CONVERSE BEFORE
		DESC "the task that must merge before this one"
	FIELD WAVE uint
		DESC "the wave of the plan the task belongs to"
	FIELD DELIVERED_BY uint
		DESC "the number of the pull request that delivers it, in @PROJECT.PCST"
			REF @PROJECT.PCST
	FIELD PURGE true|false
		DEFAULT true
		DESC "whether the cleanup pass deletes the task once archived; false keeps it"
	WHEN STATUS draft
		GATE suppressed
	WHEN STATUS todo
		GATE error
	WHEN STATUS implemented
		GATE error
		FIELD SPEC
			REQUIRED
			REPEATABLE
			FIELD IMPL
				REQUIRED
				REPEATABLE
		FIELD DELIVERED_BY
			REQUIRED

SCHEMA PACKAGE
	DESC "a package of the monorepo"
	NAME package_name
	FIELD DESC string
		REQUIRED
		DESC "what the package does, in one line"
		FIELD REF reference
			REPEATABLE
			DESC "an entity the line names, so that it is indexed"
	FIELD MANIFEST anchor
		REQUIRED
		DESC "the package manifest, path and name literal"

SCHEMA PROJECT
	DESC "a repository the corpus cites, as the home of a pull request or of a file"
	NAME project_name
	FIELD GIT_REPOSITORY repo
		REQUIRED
		DESC "the repository on the forge"

SCHEMA USAGE_REPORT
	DESC "a usage report cited as the origin of an entity; deleted by the cleanup pass once nothing"
		+ "cites it"
	NAME file_name
	FIELD FILE anchor
		REQUIRED
		DESC "the report file and the tag its template puts on the first line"
	FIELD EVALUATES uint
		REPEATABLE
		DESC "the number of the pull request the report measures"

SCHEMA GAME_RELEASE
	DESC "a released version of the game, cited as the source of what was observed in it, or named"
		+ "by HOLDS_FOR as a release the code tells apart"
	NAME version_segment

SCHEMA URL
	DESC "an external page cited as a source"
	FIELD LOCATION url
		REQUIRED
		DESC "the address of the page"

FIELDSET ReleaseScope
	DESC "the game releases the statement holds for"
	FIELD HOLDS_FOR @GAME_RELEASE|all
		REQUIRED
		REPEATABLE
		DESC "a release the statement holds for, named only if the code tells it apart from the"
			+ "release before it; a save written by an unnamed release is read by the branch of the"
			+ "last named release before it"
		DESC "all, alone: the statement does not depend on the release, a release named later"
			+ "included"

SCHEMA SECTION
	DESC "a part of the save the game writes at a fixed index"
	INCLUDE @FIELDSET.ReleaseScope
	FIELD LABEL string
		REQUIRED
		DESC "the name the project calls the section by; the single reference for that name"
	FIELD ATTESTED_BY anchor
		REQUIRED
		REPEATABLE
		CATEGORY attestation
		DESC "the committed fixture, JSON Schema, test or document that proves the index"
	FIELD INDEX uint
		REQUIRED
		DESC "the position of the section in the format the last release HOLDS_FOR names writes;"
			+ "unique among the sections of that format alone"
	WHEN STATUS active
		INCOMING CONSTRAINED_BY
	WHEN HOLDS_FOR @GAME_RELEASE.1.618
		FIELD LEGACY_INDEX uint
			REQUIRED
			DESC "the position of the section in the format 1.618 and earlier releases write"
	WHEN HOLDS_FOR all
		FIELD LEGACY_INDEX uint
			REQUIRED
			DESC "the position of the section in the format 1.618 and earlier releases write"

SCHEMA RULE
	DESC "a statement about the save or the game that a real save, or a game source, can"
		+ "contradict; a ruling of ours that could have been made otherwise is a DECISION"
	INCLUDE @FIELDSET.ReleaseScope
	FIELD DOMAIN format|game|merge
		REQUIRED
		REPEATABLE
		DESC "what the statement decides: how the save is written, how the game plays, or how two"
			+ "saves are reconciled; game only when a change to the statement would change the"
			+ "play; repeated when one statement holds in several domains"
	FIELD SPEC string
		REQUIRED
		REPEATABLE
		DESC "one falsifiable obligation"
		FIELD ATTESTED_BY anchor
			REQUIRED
			REPEATABLE
			CATEGORY attestation
			DESC "the save, fixture, test or game source that proves the obligation"
	FIELD APPLIES_TO_SECTION @SECTION
		REPEATABLE
		CONVERSE CONSTRAINED_BY
		DESC "the section the statement constrains"
	FIELD VALUES_FROM @DATATABLE
		REPEATABLE
		CONVERSE SUPPLIES
		DESC "the table holding the values the statement has authority over"
	FIELD ASSUMES @HYPOTHESIS
		REPEATABLE
		CONVERSE GROUNDS
		DESC "a hypothesis the statement rests on"
	WHEN DOMAIN merge
		FIELD CONFLICT string
			REQUIRED
			DESC "what the two saves disagree on"
		FIELD RESOLUTION string
			REQUIRED
			DESC "which of the two the merge keeps, and why"
		FIELD APPLIES_TO_SECTION
			REQUIRED
			REPEATABLE

SCHEMA COMMAND
	DESC "a command a user invokes whose output is observable"
	FIELD INVOCATION string
		REQUIRED
		DESC "the command as a user types it"
	FIELD IMPL anchor
		REQUIRED
		DESC "the entry point the invocation reaches"
	FIELD APPLIES @RULE
		REPEATABLE
		CONVERSE APPLIED_BY
		DESC "a rule the command applies"

SCHEMA HYPOTHESIS
	DESC "a statement about the save or the game assumed true and proven by nothing"
	FIELD UNTIL @TASK|string
		REQUIRED
		CONVERSE RETIRES
		DESC "the counter-example that refutes it, or the task that settles it"
	FIELD OBSERVED_IN anchor
		REPEATABLE
		DESC "where the statement was observed without being proven"

SCHEMA DATATABLE
	DESC "a file of product values no rule summarises; the rows are data, never entities"
	FIELD TABLE anchor
		REQUIRED
		DESC "the file holding the rows"
	FIELD KEY json_key
		REQUIRED
		DESC "the name of the field identifying a row"
	FIELD JSON_SCHEMA anchor
		REQUIRED
		DESC "the JSON Schema the rows of the table validate against"
