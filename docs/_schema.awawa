// Specification corpus of planet-crafter-save-tools.
//
// It lives in docs/ ; the workspace root stays the root of the public repository, which is where
// IMPL anchors resolve from and what the last argument of every command takes.
// See @DECISION.LeCorpusVitDansLeDepotPublic and @DECISION.LeCorpusEstDecoupeParDomaine.
//
// Language: the schema — declared vocabulary and the prose documenting it — is English; the prose
// of data entities stays French, by exception to the English rule of the public repository
// (@DECISION.LeSchemaEstRedigeEnAnglaisEtLesDonneesEnFrancais,
// @DECISION.LaSpecificationResteEnFrancaisMemePubliee).
//
// This file carries the cross-cutting schema; each domain carries its own beside its data.
PROJECT PlanetCrafterSaveTools
	DESC "outils de fusion et de validation de sauvegardes du jeu The Planet Crafter"
	DESC "monorepo Bun, packages prefixes par leur couche, UI SolidStart"

SCHEMA PROJECT
	DESC "project-level configuration, exactly one per corpus"

SCHEMA *
	DESC "fields legal on every entity of this corpus"
	FIELD DESC string
		REPEATABLE
		FIELD REF reference
			REPEATABLE
			DESC "the entity this sentence names, so that it is indexed"
	FIELD RATIONALE string
		REPEATABLE
		CATEGORY reasoning
		FIELD REF reference
			REPEATABLE
	FIELD SPEC string
		REPEATABLE
		FIELD IMPL anchor
			REPEATABLE
	FIELD STATUS draft|specified|implemented|superseded
		DEFAULT draft
	FIELD SOURCE string
		REPEATABLE
		DESC "where this was decided or read: date, PR number, review"
	FIELD IMPL anchor
		REPEATABLE
		DESC "where this is realised, for an entity that carries no SPEC"
	FIELD SUPERSEDES reference
		DESC "the entity this one replaces; reports print SUPERSEDED_BY on the old one"
		CONVERSE SUPERSEDED_BY
	WHEN STATUS specified
		GATE error
	WHEN STATUS implemented
		GATE error
		FIELD SPEC
			REQUIRED
			FIELD IMPL
				REQUIRED
	WHEN STATUS superseded
		GATE suppressed
		INCOMING CLOSED_BY|SUPERSEDED_BY

SCHEMA DECISION
	DESC "a ruling, and what it ruled out"
	FIELD REJECTED string
		REQUIRED
		REPEATABLE
		DESC "what was considered and ruled out"
		FIELD REF reference
			REPEATABLE
	FIELD CLOSES @OPEN_QUESTION
		REPEATABLE
		CONVERSE CLOSED_BY
	FIELD APPLIES_TO_PACKAGE @PACKAGE
		REPEATABLE
		DESC "the package whose code this decision constrains; the reverse edge is computed"
		CONVERSE GOVERNED_BY
	FIELD APPLIES_TO_TASK @TASK
		REPEATABLE
		DESC "the task whose deliverable this decision constrains; the reverse edge is computed"
		CONVERSE GOVERNED_BY

SCHEMA OPEN_QUESTION
	DESC "a point not yet settled, or a limitation whose fate nobody has decided"
	DESC "closed by a DECISION pointing here, which moves it to closed, never deleted"
	FIELD STATUS open|closed
		DEFAULT open
		DESC "open until a decision closes it; this type has no ladder to climb, so it declares its"
			+ "own two values instead of the four of SCHEMA *"
	FIELD BLOCKS reference
		REPEATABLE
		DESC "what this point prevents or weakens; the reverse edge is computed"
		CONVERSE BLOCKED_BY
	FIELD RECOMMENDATION string
		DESC "the proposed option, once it has faced its alternative"
		FIELD REF reference
			REPEATABLE
		FIELD REJECTED string
			REQUIRED
			REPEATABLE
			DESC "the alternative examined and ruled out, and why"
	WHEN STATUS open
		GATE error
	WHEN STATUS closed
		GATE suppressed
		INCOMING CLOSED_BY
